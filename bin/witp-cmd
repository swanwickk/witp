#!/usr/bin/env python3
"""
witp-cmd: 前线指挥官与主 Agent 专用操作命令行工具 (Commander's Field Toolkit)
充当主 Agent 的「手」：
- witp-cmd staff           # 召唤参谋部出具《作战方案建议书》
- witp-cmd launch          # 一键重开并就位珊瑚海 1942 新局
- witp-cmd set-dest <tf> <x> <y>  # 亲手下达编队航向指令 (探针法+偏移补偿)
- witp-cmd set-cap <ag> <pct>     # 亲手下达战斗机防空 CAP 比例指令
- witp-cmd end-turn        # 亲手下达 E+YES 过回合指令并等待结算
- witp-cmd status          # 检查当前屏幕画面与战局状态
"""

import sys
import os
import json
import argparse
import subprocess
import time
import re

_VENV_PY = "/root/.hermes/hermes-agent/venv/bin/python3" if os.path.exists("/root/.hermes/hermes-agent/venv/bin/python3") else sys.executable

# ──────────────────── TF 目的地设置的辅助函数（第六局新增） ────────────────────

def _shot_to(path):
    """截取游戏区画面（自动剔除窗口外区域）。

    ★2026-09-25 加固（一）★ 必须**校验新鲜度**：
      实测 `witp_shot_game` 偶发失败（截图尺寸断言不通过时直接 return 1），
      但它失败时**不会覆盖** /tmp/witp_shot.png —— 若照样 `cp` 旧图，
      后续 OCR 全部读到**上一帧**，表现为「读数卡住不变」，
      极易被误判为控件/交互问题（本次排查即被误导数轮）。

    ★2026-09-25 加固（二）★ **绝不能"先删再拍"**：
      `witp_shot_game` 在 `witp_crop_ok` 失败时**直接 return 1 且不产出** /tmp/witp_shot.png。
      旧实现先 `os.remove` 再重试 → 三次全失败后**一个文件都不剩**，
      调用方 `Image.open` 抛异常 → 被 except 吞掉 → 表现为"读到 0 行"的静默失败
      （`_read_tf_dest_dynamic` 返回 0 行即由此而来，解析逻辑本身没问题）。
      改为 **mtime 递增判定 + 已有图兜底**：只要曾拍成过一次，目标路径就一定存在。
    """
    _p = "/tmp/witp_shot.png"
    prev = os.path.getmtime(_p) if os.path.exists(_p) else 0.0
    for _try in range(3):
        subprocess.run(["bash", "-c",
                        "source /root/.hermes/workspace/witp-ui.sh && witp_shot_game"],
                       capture_output=True)
        if os.path.exists(_p):
            m = os.path.getmtime(_p)
            if m > prev and (time.time() - m) < 30:
                subprocess.run(["bash", "-c", f"cp {_p} {path}"], capture_output=True)
                return True
        time.sleep(0.6)
    # 兜底：拍不出新图也要把现有图交出去，绝不留下不存在的目标路径
    if os.path.exists(_p):
        subprocess.run(["bash", "-c", f"cp {_p} {path}"], capture_output=True)
    return False

def _ocr(path, args="- psm 6"):
    r = subprocess.run(f"tesseract {path} {args} 2>/dev/null", shell=True, capture_output=True, text=True)
    return r.stdout

def _ensure_tf_list_open():
    """确保 TF 列表界面处于打开状态，并获取键盘/滚动焦点。"""
    for attempt in range(3):
        _shot_to("/tmp/_witp_check_tf_list.png")
        txt = _ocr("/tmp/_witp_check_tf_list.png", args="- --psm 11")
        if "Task Forces" in txt or "Air Ops" in txt or "SubOps" in txt or "SurfaceCombat" in txt:
            return True
        vnc_key("escape")
        time.sleep(1.0)
        focus_map()
        vnc_key("t")
        time.sleep(3.0)
    return False

def _scan_tf_numbers():
    """扫描 T 列表编号列，返回 [(y_center, num_str)]（按 y 升序）。

    ★2026-09-29 修复（换阵营暴露的系统性缺陷）★
      原实现有三处**绑死盟军侧列表布局**的常量：
        ① 编号列 x 阈值 `left < 225`；② 裁剪窗 `700x300+150+215`；③ 行距写死。
      换日军侧后返回**空列表** → `_find_tf_row` 返回 None → `set-dest` 中止；
      更糟的是原代码用 `return` 而非 `sys.exit(1)`，**退出码仍是 0**，
      表现为「命令成功但游戏没变」的静默失败（极易误判为游戏挂起/时序问题）。

      现改为**只认编号列窄带 + 强制 psm6 + 数字白名单**：
        · 实测列表列头（TF/Mission/…）在 y≈215–240，编号列 x≈158–198。
        · 大窗全表 TSV 会把编号列漏读（Mission 列起点 x≈197 紧贴编号列），
          故**只裁编号列窄带**，逐行 TSV 归位，不依赖任何写死的列 x 阈值。
        · **必须 `--psm 6`**：默认 psm 3 会把数字列读成乱码（实测 'ww'/'ho'/'Oah'）。
        · 行 y 直接由 TSV top 换算（实测与行中心逐行相符，7 行全对）。
    """
    _shot_to("/tmp/_witp_cmd_row.png")
    sc, ox, oy = 800, 158, 242
    crop = "40x230+158+242"
    cmd = (f"convert /tmp/_witp_cmd_row.png -crop {crop} +repage "
           f"-resize {sc}% -colorspace Gray -normalize /tmp/_ryd.png && "
           f"tesseract /tmp/_ryd.png stdout --psm 6 "
           f"-c tessedit_char_whitelist=0123456789 tsv 2>/dev/null")
    out = []
    try:
        raw = subprocess.check_output(cmd, shell=True, timeout=25).decode(errors="replace")
        for line in raw.splitlines()[1:]:
            parts = line.split("\t")
            if len(parts) < 12:
                continue
            conf = float(parts[10]) if parts[10] not in ("-1", "") else 0
            word = parts[11].strip()
            if conf <= 20 or not re.fullmatch(r"\d{1,2}", word):
                continue
            y = int(int(parts[7]) * 100.0 / sc) + oy
            out.append((y, word))
    except Exception:
        pass
    # 同行去重（同数字重复识别取前者）
    ded, seen = [], set()
    for y, w in sorted(out):
        if any(abs(y - yy) <= 5 for yy, _ in ded):
            continue
        ded.append((y, w))
        seen.add(w)
    return ded



def _tf_ids_from_layer():
    """从读层取 T 列表编号的**升序**列表（用于确定性行定位）。

    ★设计要点★ 游戏 T 列表按编号升序排列，行距为 UI 常量。
    因此 `行 y = BASE + PITCH × (编号在升序表中的下标)` **可解析算出**，
    **完全不需要 OCR 定位行** —— 彻底消除 OCR 抖动导致的定位失败。
    """
    for p in ("/root/.hermes/workspace/witp-reader/state/taskforces.json",):
        try:
            with open(p, encoding="utf-8") as f:
                d = json.load(f)
            lst = (d if isinstance(d, list)
                   else (d.get("task_forces") or d.get("taskforces") or []))
            ids = sorted(int(t["record_id"]) for t in lst
                         if isinstance(t.get("record_id"), int))
            if ids:
                return ids
        except Exception:
            pass
    return []


# T 列表控件几何常量（滚到顶后首行 y 与行距）——实测两阵营一致（同一列表控件）
_TF_ROW_BASE = 246
_TF_ROW_PITCH = 14


def _row_num_at(y):
    """读某一行编号列的窄带数字（用于确定性定位后的**定向核验**）。"""
    _shot_to("/tmp/_witp_cmd_row.png")
    sc, ox = 800, 158
    crop = f"40x18+158+{int(y) - 9}"
    cmd = (f"convert /tmp/_witp_cmd_row.png -crop {crop} +repage "
           f"-resize {sc}% -colorspace Gray -normalize /tmp/_rn.png && "
           f"tesseract /tmp/_rn.png stdout --psm 7 "
           f"-c tessedit_char_whitelist=0123456789 2>/dev/null")
    try:
        raw = subprocess.check_output(cmd, shell=True, timeout=20).decode(errors="replace")
        m = re.findall(r"\d{1,2}", raw)
        return m[0] if m else None
    except Exception:
        return None


def _find_tf_row(tf_id):
    """定位 T 列表中目标 TF 所在行的中心 y。

    ★2026-09-29 重写（换阵营暴露的系统性缺陷）★
      原实现完全依赖 OCR 扫描编号列，有三处绑死盟军侧布局的常量
      （编号列 x 阈值 225 / 裁剪窗 700x300+150+215 / 行距），换日军侧后
      **返回空列表** → 定位失败 → `set-dest` 中止且退出码仍为 0（静默失败）。

      新实现改为**确定性定位 + 定向核验**：
        ① 滚到列表顶部（列表按编号升序）；
        ② 从**读层** `taskforces.json` 取升序编号表；
        ③ `y = BASE + PITCH × 下标` 解析算出（不 OCR）；
        ④ 只对算出的一行做窄带 OCR **核验**；不符则在邻域微调；
        ⑤ 读层缺失/核验全败时才回退全列 OCR 扫描。
      这样 OCR 只用于「确认」而非「搜索」，把静默失败概率降到最低。
    """
    target = re.sub(r"[^0-9]", "", str(tf_id)).lstrip("0") or "0"

    # ① 滚到列表顶部
    vnc_click(250, 205, "click"); time.sleep(0.5)
    for _ in range(4):
        vnc_key("home"); time.sleep(0.35)
    time.sleep(1.2)

    # ② 全列扫描一次（仅作一致性校验；不用于逐行搜索）
    rows = _scan_tf_numbers()
    scan = {n: y for y, n in rows}

    # ③ 读层升序表 → 解析算行
    ids = _tf_ids_from_layer()
    if ids and int(target) in ids:
        idx = ids.index(int(target))
        y0 = _TF_ROW_BASE + _TF_ROW_PITCH * idx

        # 一致性校验：扫描行与公式行的吻合率
        hit = sum(1 for i, n in enumerate(ids)
                  if scan.get(str(n)) is not None
                  and abs(scan[str(n)] - (_TF_ROW_BASE + _TF_ROW_PITCH * i)) <= 3)
        if hit >= max(2, int(len(ids) * 0.6)):
            # ★公式可信 → 以公式为准★
            #   扫描此时仅作一致性门（防读层与可见列表不一致，如 Show 筛选隐藏编队）；
            #   实测 OCR 会把行 5 的 '5' 误读成 '7'，若以扫描为准会把 TF7 定位到 TF5 的行。
            if scan.get(target) is not None and abs(scan[target] - y0) > 3:
                print(f"[witp-cmd] ⚠️ TF{target} 扫描读数 y={scan[target]} 与公式 y={y0} 不符"
                      f"（一致性 {hit}/{len(ids)} 通过）→ 以公式为准")
            return y0
        print(f"[witp-cmd] ⚠️ 公式一致性仅 {hit}/{len(ids)} → 回退扫描定位")

    # ④ 回退：直接用扫描结果
    if scan.get(target) is not None:
        return scan[target]

    # 位置兜底：列表按编号升序，target 落在已识别区间内则按比例插值
    nums = [(y, int(n)) for y, n in rows if n.isdigit()]
    if len(nums) >= 2:
        t = int(target)
        for i in range(len(nums) - 1):
            y0, n0 = nums[i]
            y1, n1 = nums[i + 1]
            if n0 < t < n1:
                est = int(y0 + (y1 - y0) * (t - n0) / (n1 - n0))
                print(f"[witp-cmd] ⚠️ 编号 {target} 未被 OCR 识别 → 按升序位置插值 y={est}（相邻行 {n0}/{n1}）")
                return est

    print(f"[witp-cmd] 未识别到编号 {target}；当前列表识别到的编号：{[n for _, n in rows]}")
    return None

_CONFUSE = str.maketrans({"O": "0", "o": "0", "D": "0", "Q": "0", "l": "1", "I": "1",
                          "|": "1", "i": "1", "Z": "2", "z": "2", "S": "5", "s": "5",
                          "B": "8", "g": "9", "b": "6", "G": "6", "T": "7", "q": "9"})


def _extract_coord(txt):
    """从一行 OCR 文本中提取目标 Hex 坐标（多级容错）。

    第 1 级：识别 "move to 102,143" / "near to 102,143"（分隔符任意）
    第 2 级：对易混字符（O/l/I/S/B/Z）做归一化后再试
    第 3 级：兜底取行内最后两段 2~3 位数字
    """
    if not txt:
        return None
    for t in (txt, txt.translate(_CONFUSE)):
        m = re.search(r"(?:moveto|nearto|near\s*to|move\s*to|to)\D{0,6}(\d{2,3})\D{1,3}(\d{2,3})",
                      t, re.IGNORECASE)
        if m:
            return (int(m.group(1)), int(m.group(2)))
    for t in (txt, txt.translate(_CONFUSE)):
        nums = re.findall(r"\d{2,3}", t)
        if len(nums) >= 2:
            return (int(nums[-2]), int(nums[-1]))
    return None


def _read_tf_dest_from_list(tf_id):
    """从 T 列表行中读出目标 TF 当前的目的地 Hex (x, y)。

    2026-09-24 重写（四步修复，前三次失败已记录）：
      1) 裁剪区原 x=150..850，Location 列延伸到 ~1010 → 扩到全宽。
      2) 坐标分隔符原只认半角逗号，实测 tesseract 常读成点号或空格
         ("moveto 106.142" / "moveto 106 142") → 恒不匹配。改用非数字分隔匹配。
      3) 整块 psm6 OCR 会把 TF 编号读错（14→"_ 14"、15→"45"）
         → 改为按行带逐行裁剪 + 单行 psm7。
      4) 行左侧地图标签文字（"tagula"、岛名）混入行首 → 裁剪起点右移到 x=140。

    定位策略：① 行首编号匹配（主）；② 行序兜底（T 列表按编号升序、
    当前 11 个 Human 编队顺序固定为 14,15,16,17,18,20..25）。
    注意：OCR 对数字 0/5/6/8 仍有误读可能，最终以读层 target_x/y 为准。
    """
    target = re.sub(r"[^0-9]", "", str(tf_id)).lstrip("0") or "0"
    _shot_to("/tmp/_witp_read_dest.png")
    # ★2026-10-01 修（换阵营暴露的「写死单侧」缺陷）★
    #   原 ROW_YS/KNOWN_ORDER 是**盟军侧**的写死行位与编号序列
    #   （14,15,16,17,18,20..25）—— 日军编队是 TF1..TF30，
    #   二者完全对不上 ⇒ set-dest 在日军侧"行命中但读不到坐标"，永不收敛。
    #   改为**确定性公式**（已在本项目实测）：T 列表按编号升序，行距固定 14px，
    #   首行（编号最小者）中心 y=246 ⇒ y = 246 + 14 × (该编号在升序表中的下标)。
    ROW_BASE, ROW_PITCH = 246, 14
    try:
        _ids = sorted(set(int(re.sub(r"[^0-9]", "", str(t)) or 0)
                          for t in _tf_ids_from_layer()))
    except Exception:
        _ids = []
    ROW_YS = []
    KNOWN_ORDER = []
    if _ids:
        for i, n in enumerate(_ids):
            KNOWN_ORDER.append(str(n))
            ROW_YS.append(ROW_BASE + ROW_PITCH * i)
        print(f"[witp-cmd] T 列表行位（读数层 {len(_ids)} 个编队动态生成）："
              f"首行 y={ROW_YS[0]} 末行 y={ROW_YS[-1]}")
    else:
        # 读层不可用时回落一屏常见行位（仅作兜底，随后必然回读核验）
        ROW_YS = [ROW_BASE + ROW_PITCH * i for i in range(12)]
        KNOWN_ORDER = [str(i + 1) for i in range(12)]
        print("[witp-cmd] ⚠ 读层编队列表不可用，T 列表行位按 1..12 兜底（务必回读核验）")
    from PIL import Image, ImageOps
    rows = []
    try:
        full = Image.open("/tmp/_witp_read_dest.png")
        for y in ROW_YS:
            crop = full.crop((140, y - 9, 1024, y + 9))
            crop = ImageOps.autocontrast(ImageOps.grayscale(crop))
            crop = crop.resize((crop.width * 4, crop.height * 4), Image.LANCZOS)
            crop.save("/tmp/_trow.png")
            # ★2026-09-24 修复★ 单次 psm7 对个别编队（实测 TF14）恒返回 None：
            #   改为 psm 7→6→13 三轮尝试 + 易混字符归一化 + 末两段数字兜底。
            coord = None
            txt = ""
            for _psm in ("7", "6", "13"):
                txt = _ocr("/tmp/_trow.png", f"- --psm {_psm}")
                txt = re.sub(r"([0-9])[ilI|]([0-9])", r"\1\2", txt)
                coord = _extract_coord(txt)
                if coord:
                    break
            mn = re.match(r"\D{0,8}(\d{2})\D", txt)
            num = ((mn.group(1).lstrip("0") or "0") if mn else None)
            rows.append({"num": num, "coord": coord})
    except Exception:
        return None
    # 策略①：行首编号匹配
    for r in rows:
        if r["num"] == target and r["coord"]:
            return r["coord"]
    # 策略②：行序兜底（T 列表数据行按编号升序排列）
    for i, r in enumerate(rows):
        if i < len(KNOWN_ORDER) and KNOWN_ORDER[i] == target and r["coord"]:
            return r["coord"]
    return None


# ★2026-09-24 新增：探针标定值缓存★
#   探针点 (500,500) 对应的 hex 由「屏幕位置」决定，与操作哪个编队无关
#   （实测 TF16/18/20 均读出 (112,144)）。个别编队因 OCR 字型误读会得到
#   稳定但错误的值（如 TF15 恒读成 (412,144)），此时复用已成功标定值即可。
PROBE_CACHE_FILE = "/tmp/witp_probe_cache.json"


def _load_probe_cache():
    try:
        with open(PROBE_CACHE_FILE) as f:
            d = json.load(f)
        h = d.get("hex")
        if h and len(h) == 2:
            return (int(h[0]), int(h[1]))
    except Exception:
        pass
    return None


def _save_probe_cache(h):
    try:
        with open(PROBE_CACHE_FILE, "w") as f:
            json.dump({"hex": [int(h[0]), int(h[1])], "ts": time.time()}, f)
    except Exception:
        pass


def _find_airgroup_row(ag_id, list_key="a"):
    """用 TSV 按行归并识别航空队名，返回目标行中心 y。

    ★2026-09-24 重写（根因修复）★
      原实现从 y=240 起按固定步长 14 逐行裁剪。实测 N 列表**首行中心在 y≈259**
      （即 245+14k），从 240 起扫会整行错位 → 每行都跨两行文字 → OCR 全乱码，
      舰载中队因此**从未成功定位**（set-cap 对舰载机完全失效）。
      改为：对名称列做整块 TSV，按 y 归并成行后再匹配名称 —— 与步长/首行偏移无关。
    """
    from PIL import Image, ImageOps
    import collections
    import csv as _csv

    clean_target = re.sub(r"[^A-Za-z0-9]", "", str(ag_id)).lower()
    _shot_to("/tmp/_witp_air_rows.png")
    im = Image.open("/tmp/_witp_air_rows.png").crop((150, 230, 440, 500))
    im = ImageOps.autocontrast(ImageOps.grayscale(im)).resize((im.width * 4, im.height * 4), Image.LANCZOS)
    im.save("/tmp/_anames.png")
    subprocess.run("tesseract /tmp/_anames.png /tmp/_anames --psm 6 tsv 2>/dev/null", shell=True)

    lines = collections.defaultdict(list)
    try:
        with open("/tmp/_anames.tsv") as f:
            for r in _csv.DictReader(f, delimiter="\t", quoting=_csv.QUOTE_NONE):
                t = (r.get("text") or "").strip()
                if not t:
                    continue
                y = int(r["top"]) / 4.0 + 230
                lines[round(y / 7)].append((int(r["left"]) / 4.0 + 150, t))
    except Exception:
        return None

    # ★2026-09-26 关键加固★ 航空队名匹配加「字形混淆归一 + 唯一性要求」。
    #   实测 N 列表 OCR 会把 **V 读成 Y 或 N**（真身 VS-5 → OCR `ys5sbd3dauntlessy16`；
    #   1/VCS-5 → `lvcss50c1seagull4`），导致 VS-2/VS-5 这类**舰载专职侦察中队**
    #   永远匹配不上 —— 侦察落子因此长期失效（失败日志显示"识别到的行"里明明有它）。
    #   归一规则：V/Y→v、I/L/|→1、O→0、S→5、B→8（在既有 i/l→1、o→0、S→5、B→8 上补 V↔Y）。
    #   ★安全底线★ 必须**唯一命中**才认；命中多行一律拒收 —— 宁可失败也不改错部队。
    def _canon(s):
        s = re.sub(r"[^A-Za-z0-9]", "", str(s)).lower()
        # ★2026-10-01 补：编号段字形归一 ★
        #   实测 OCR 把日军中队编号 `K-1` 读成 `K41`、`K-2` 读成 `K2`，
        #   而 `1` 也常被读成 `4`/`l`/`i`。若不做二次归一，
        #   `Genzan Ku K-1`(→genzankuk1) 永远对不上 OCR 的 `genzankuk41`。
        #   规则：数字位统一 4→1（4 在该位置只会是 1 的误读），i/l→1。
        s = s.replace("y", "v").replace("i", "1").replace("l", "1")
        s = s.replace("o", "0").replace("s", "5").replace("b", "8")
        s = re.sub(r"4", "1", s)          # 编号位 4 视为 1 的误读
        return s

    ct = _canon(ag_id)
    hits = []
    seen = []                      # ← 必须初始化！上次改这段时漏了，导致 NameError
    for k in sorted(lines):
        ws = sorted(lines[k])
        txt = " ".join(w for _, w in ws)
        norm = re.sub(r"[^A-Za-z0-9]", "", txt).lower()
        yc = int(k * 7) + 6
        seen.append(f"{yc}:{norm[:18]}")
        if ct and ct in _canon(txt):
            hits.append(yc)
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        print(f"[witp-cmd] ⚠️ {ag_id} 归一后命中多行 {hits} → **拒收**（不猜，避免改错部队）")
        print(f"   识别到的行 → {seen[:16]}")
        return None
    # ★2026-09-26 兜底★ 设计ator（编号段）被 OCR 读烂时按**后缀**再匹配一次。
    #   `No.11 Sqd RAAF` 的编号被读成 `noid`；尾部的 `5qdraaf`（Sqd RAAF）匹配良好。
    #
    # ★2026-09-30 修（换阵营暴露的「判据过严」缺陷）★
    #   日军中队**共用后缀**：`EI-1 Daitai`/`EII-1 Daitai` 后缀都是 `da1ta1`，
    #   `EIII-1 Chutai`/`EIII-2 Chutai` 后缀都是 `1chuta1`/`2chuta1` ⇒
    #   原「必须唯一命中，多则拒收」的规则使**四支舰战中队全部被拒**，航母 CAP 一个都设不上。
    #   该唯一性要求是照**盟军**命名（VF-2/VB-2/VS-2 后缀互异）写的，换侧即失效。
    #   修法：歧义时不立刻拒收，改用**编号段**（后缀之前的部分，如 `ei1`/`eii1`）在候选行里二次判别；
    #   仍不唯一才拒收。编号段读烂时退化为「候选里取第一个」，但**必须打印告警**，不静默。
    if len(ct) > 8:
        _tail = ct[4:]
        _h2 = []
        for k in sorted(lines):
            _txt = " ".join(w for _, w in sorted(lines[k]))
            if _tail and _tail in _canon(_txt):
                _h2.append((int(k * 7) + 6, _canon(_txt)))
        if len(_h2) == 1:
            print(f"[witp-cmd] ⓘ {ag_id} 编号段 OCR 不可辨，按后缀 '{_tail}' 唯一命中 y={_h2[0][0]}")
            return _h2[0][0]
        if len(_h2) > 1:
            # ★二次判别：用编号段（ct 的前 4 位，如 ei1/eii1）在候选里筛 ★
            _head = ct[:4]
            _h3 = [(y, t) for (y, t) in _h2 if _head and _head in t]
            if len(_h3) == 1:
                print(f"[witp-cmd] ⓘ {ag_id} 后缀歧义（{len(_h2)} 行），按编号段 '{_head}' 二次判别 → y={_h3[0][0]}")
                return _h3[0][0]
            # 编号段也判不出来：若全部候选同属一个「编号前缀族」仍不唯一 → 拒收，避免改错部队
            print(f"[witp-cmd] ⚠️ {ag_id} 后缀 '{_tail}' 命中 {len(_h2)} 行且编号段 '{_head}' "
                  f"无法唯一判别 → **拒收**（不猜）")
            for (y, t) in _h2[:8]:
                print(f"      候选 y={y}: {t[:40]}")
            return None
    print(f"[witp-cmd] 未匹配到 {ag_id}；该列表识别到的行 → {seen[:16]}")
    return None


def _scroll_map(direction, seconds):
    """★2026-10-01 新增（手册 4.2.5 权威 + 实测）★ 用「鼠标停画面边缘」滚动地图视野。

    手册 4.2.5 原文：「use the arrow keys or **scroll the mouse cursor to the Tactical
    Map's edges** in order to move the map view」。

    ★实测关键（此前多次测「边缘无效」的真因）★
      触发带**只有窗口绝对最外 1 像素**：
        左 x=0 / 右 x=1023 / 下 y=767  → 有效（画面变化 22~24%）
        内侧 x=3 / x=1022 / y=766      → **完全无效**（0.0%）
      上边缘 y=0 被窗口标题栏占用，实测不可用。
    方向语义（内容位移反推）：停左边缘→视野西移；停右边缘→视野东移；停下边缘→视野南移。
    """
    pt = {"west": (0, 380), "east": (1023, 380), "south": (500, 767)}.get(direction)
    if not pt:
        return False
    vnc_click(500, 300, "click") if False else None
    try:
        from lib.executor import vnc_click as _vc
        _vc(pt[0], pt[1], "click") if False else None
    except Exception:
        pass
    # 只移动，不点击
    import subprocess as _sp
    _ox, _oy = get_window_offset() if "get_window_offset" in globals() else (188, 150)
    _sp.run(["xdotool", "mousemove", str(int(_ox + pt[0])), str(int(_oy + pt[1]))],
            env={**os.environ, "DISPLAY": ":98"}, check=False)
    time.sleep(seconds)
    _sp.run(["xdotool", "mousemove", str(int(_ox + 500)), str(int(_oy + 300))],
            env={**os.environ, "DISPLAY": ":98"}, check=False)
    time.sleep(0.6)
    return True


def _click_map_hex(tx, ty):
    """在地图上点击目标 hex。

    ★2026-09-29 修正★ 原按 42.86/37.5 px/格写死换算（实测真值约 40.0）。
    现改为读标定值并过范围闸门，超范围回落 40.0。

    ★2026-10-01 追加★ 基准格 `_current_cursor_hex()` 实测**不可靠**：
    顶栏 Hex 是「上次点击选中的格」，**不随鼠标移动更新**（只移动鼠标时 Hex 恒定），
    故它给出的基准格可能是很早以前的点击残留 → 换算全错、视野不动。
    对策：**先用边缘滚动把目标拉进视野半径**，再按标定点击；若基准格明显不可信
    （与目标距离超过一个屏宽对应的格数），先滚动再算。
    """
    cur = _current_cursor_hex()
    if cur is None:
        vnc_click(512, 384, "click")
        return
    W = H = None
    try:
        import sys as _s
        _s.path.insert(0, "/root/.hermes/profiles/witp/witp-agent")
        from lib import mapgeom as _mg
        g = _mg.load_geom()
        if g:
            W, H = float(g["W"]), float(g["H"])
    except Exception:
        pass
    if W is None or H is None or not (25.0 <= W <= 60.0) or not (25.0 <= H <= 60.0):
        W, H = 40.0, 40.0
    cx, cy = cur
    # ★2026-10-01 追加：基准格不可信时先用边缘滚动逼近 ★
    #   基准格 `cur` 来自顶栏 Hex（= 上次点击选中的格），可能已过期。
    #   若它与目标的距离超过半屏所能覆盖的格数（W≈42.5px/格、半屏 512px ≈ 12 格），
    #   直接按它换算会点出屏幕 → 视野纹丝不动（这正是 set-dest 长期"不收敛"的成因）。
    #   对策：先按方位滚动，把目标拉进视野半径内，再点击。
    for _ in range(6):
        dxh, dyh = tx - cx, ty - cy
        if abs(dxh) <= 11 and abs(dyh) <= 9:
            break
        moved = False
        if dxh < -11:
            moved = _scroll_map("east", min(2.5, max(0.8, abs(dxh) * 0.055)))
        elif dxh > 11:
            moved = _scroll_map("west", min(2.5, max(0.8, abs(dxh) * 0.055)))
        if dyh > 9:
            moved = _scroll_map("south", min(2.5, max(0.8, abs(dyh) * 0.055))) or moved
        elif dyh < -9:
            # 北向无可用边缘（上边缘被标题栏占用）——用东西向滚动配合地图绕行不成立，
            # 故此分支保持原状并明确告警，交由调用方核验。
            pass
        if not moved:
            print(f"[witp-cmd] ⚠ 视野滚动无法继续逼近（基准格({cx},{cy}) 距目标({tx},{ty}) "
                  f"过远且北向边缘不可用）；仍按标定点击，落点请以结算后读层核验")
            break
        cur = _current_cursor_hex()
        if cur is None:
            break
        cx, cy = cur
    gx = 512 + (tx - cx) * W
    gy = 384 + (ty - cy) * H
    gx = max(30, min(994, int(gx)))
    gy = max(30, min(738, int(gy)))
    print(f"[witp-cmd] 光标格 ({cx},{cy}) → 目标 ({tx},{ty}) "
          f"点击 ({gx},{gy})  [比例 {W:.1f}/{H:.1f} px/格]")
    vnc_click(gx, gy, "click")
    time.sleep(1.0)

def _parse_hex_field(txt, last=None):
    """宽容但**严格校验**地解析顶栏 Hex 字段。

    ★2026-09-25 实测两个坑★
      ① 裁剪起点太靠右（x=884）会把首位数字切掉：`Hex:100 140` → 只剩 "4014"，
         解析器用 (2,2) 切分当作 (40,14) 接受 → **静默错误**（比读不出更危险）。
      ② 阈值二值化会毁掉抗锯齿笔画，导致丢字。故先试「不二值化 + autocontrast」。
    现规则：必须出现 `Hex` 标签；数字串优先 3+3 切分；**至少 5 位数字**；
    若给了 last（上次成功读数）则再要求不做离谱跳变（|Δ|≤40），否则拒收。
    """
    if not txt:
        return None, None
    t = re.sub(r"\s+", "", txt)
    m = re.search(r"[Hh][e3a][xXkK][:;.,]?", t)
    if not m:
        return None, None                      # 没读到标签 → 一律拒收
    digits = re.sub(r"\D", "", t[m.end():])[:6]
    if len(digits) < 5:                        # 真正的 hex 至少 5 位（如 100140 / 99155）
        return None, None
    cands = []
    for a, b in ((3, 3), (3, 2), (2, 3)):
        if len(digits) >= a + b:
            x, y = int(digits[:a]), int(digits[a:a + b])
            if 10 <= x <= 250 and 10 <= y <= 250:
                cands.append((x, y))
    if not cands:
        return None, None
    if last:
        good = [c for c in cands if abs(c[0] - last[0]) <= 40 and abs(c[1] - last[1]) <= 40]
        if not good:
            return None, None                  # 与上次读数跳变过大 → 判为误读
        return good[0]
    return cands[0]


def _current_cursor_hex(last=None):
    """从顶栏读当前光标 hex（宽裁剪 + 多策略 OCR + 严格校验 + 重试）。"""
    from PIL import Image, ImageOps
    for _attempt in range(3):
        _shot_to("/tmp/_witp_cmd_hex.png")
        try:
            im = Image.open("/tmp/_witp_cmd_hex.png").crop((876, 0, 1000, 24))
        except Exception:
            time.sleep(0.4)
            continue
        g = ImageOps.autocontrast(ImageOps.grayscale(im))
        for th in (None, None, 130, 110):      # 先两次不二值化（保笔画），再试阈值
            img = g if th is None else g.point(lambda p, t=th: 255 if p > t else 0)
            img = img.resize((img.width * 6, img.height * 6), Image.LANCZOS)
            img.save("/tmp/_witp_cmd_hex_zoom.png")
            h = _parse_hex_field(_ocr("/tmp/_witp_cmd_hex_zoom.png", "- --psm 7"), last)
            if h[0] is not None:
                return h
        time.sleep(0.4)
    return None



# ─── 动态行识别版：T 列表编队目的地读取（2026-09-25 新增，取代写死的 ROW_YS/KNOWN_ORDER）───
# 动机：旧实现用固定 ROW_YS=[250,264,...] 逐行裁剪 + 行序兜底（写死 14,15,16,17,18,20..25），
#   既**绑死剧本**，也是「TF16 读出 TF17 的目标」这类**读错行**的根源。
# 新做法：动态切行带（idgets.bright_row_bands）→ 分两段窄裁剪 OCR：
#   ① 行首编号列 x≈163-200（做实体校验）② 目的地列 x≈712-1000（读 moveto/near to 后的坐标）
#   并把 OCR 字形混淆纳入解析（i/l→1、o→0），关键词自身也容忍混淆（m0vet0/nearto）。
_TF_ID_COL = (166, 182)      # ★实测★ 行首编号列。**切勿放宽**：x163 起会混入左标记、
                             #   再宽会混入单位图标，OCR 随即把 "13" 读成 "43"、"14" 读成 "44"
                             #   （编号列真值：13,14,15,16,17,18,20..25 全对）
_TF_DEST_COL = (712, 1000)
_TF_LIST_BOX = (160, 240, 200, 440)


def _ocr_strip(x0, y0, x1, y1, whitelist=None, psm=7):
    from PIL import Image, ImageOps
    try:
        img = Image.open("/tmp/_witp_tfl.png").convert("RGB")
    except Exception:
        return ""
    c = ImageOps.autocontrast(img.crop((x0, y0, x1, y1)).convert("L"))
    c = c.resize((c.width * 8, c.height * 8), Image.LANCZOS)
    c.save("/tmp/_witp_strip.png")
    args = f"- --psm {psm}" + (f" -c tessedit_char_whitelist={whitelist}" if whitelist else "")
    return _ocr("/tmp/_witp_strip.png", args).strip()


def _parse_dest_text(txt, numeric_hint=None):
    """解析目的地列文本。返回 (x,y) 或 None（基地名 / at sea 一律返回 None，不猜）。

    ★2026-09-26 关键修正★ 坐标一律以 **numeric_hint**（对同一区域用「纯数字白名单」
      再 OCR 一遍的结果）为准，**判据不得再用「字母→数字」替换**。
      实证：游戏字体里 `9` 与 `S` 形近，OCR 会把真值 `109` 读成 `10S`；
      而旧实现在数值段做 `S→5`，于是 `10S` 被改成假的 **105** ——
      set-dest 明明已精确设到 (109,142) 并报收敛，核验却读回 (105,142)，
      造成"报成功却核验不符"的假矛盾（视觉放大 5 倍逐字符确认真值就是 109）。
      数字白名单 OCR 不给字母留余地，从根上消除这类误读。
    """
    if not txt:
        return None
    t = re.sub(r"\s+", "", txt)
    m = re.search(r"m[o0]v[e3]t[o0]|n[e3][a4]r[a4]?t[o0]?", t, re.I)
    seg = t[m.end():] if m else t
    # ① 优先用数字白名单读到的数字串（≥4 位才够一组 x,y）
    if numeric_hint:
        hd = re.sub(r"\D", "", numeric_hint)
        for a, b in ((3, 3), (3, 2), (2, 3)):
            if len(hd) >= a + b:
                x, y = int(hd[:a]), int(hd[a:a + b])
                if 10 <= x <= 250 and 10 <= y <= 250:
                    return (x, y)
    # ② 回退：从通用 OCR 文本取数字（保留 i/l→1、o→0，但**不再做 S→5/B→8**）
    seg2 = (seg.replace("i", "1").replace("l", "1").replace("I", "1")
               .replace("o", "0").replace("O", "0"))
    nums = re.findall(r"\d{2,3}", seg2)
    if len(nums) >= 2:
        x, y = int(nums[0]), int(nums[1])
        if 10 <= x <= 250 and 10 <= y <= 250:
            return (x, y)
    d = re.sub(r"\D", "", seg2)
    for a, b in ((3, 3), (3, 2), (2, 3)):
        if len(d) >= a + b:
            x, y = int(d[:a]), int(d[a:a + b])
            if 10 <= x <= 250 and 10 <= y <= 250:
                return (x, y)
    return None



def _read_dest_coords(yc):
    """★2026-09-26 新增★ 按「词框」逐词读目的地坐标，返回 ((x,y) 或 None, 原文)。

    为什么不能整段 OCR：游戏字体里 `9` 与 `S` 形近，整段会把 `109` 读成 `10S`，
    再怎么归一都救不回来（S→5 会变 105、丢 S 又会切分错乱）。
    改为：TSV 拿到每个词的精确框 → 只对**坐标词**各自裁剪、放大 10 倍、
    用数字白名单单独 OCR → 单字符歧义大幅下降（实测可稳定读出 109）。
    """
    import collections, csv as _csv
    from PIL import Image, ImageOps
    _shot_to("/tmp/_witp_tfl.png")
    im = Image.open("/tmp/_witp_tfl.png").convert("RGB")
    x0, x1 = _TF_DEST_COL[0], _TF_DEST_COL[1]
    crop = im.crop((x0, yc - 7, x1, yc + 7))
    crop = ImageOps.autocontrast(ImageOps.grayscale(crop)).resize(
        (crop.width * 3, crop.height * 3), Image.LANCZOS)
    crop.save("/tmp/_dest_tsv.png")
    subprocess.run("tesseract /tmp/_dest_tsv.png /tmp/_dest_tsv --psm 7 tsv 2>/dev/null",
                   shell=True)
    words = []
    try:
        with open("/tmp/_dest_tsv.tsv") as f:
            for r in _csv.DictReader(f, delimiter="\t", quoting=_csv.QUOTE_NONE):
                t = (r.get("text") or "").strip()
                if not t:
                    continue
                left = int(r["left"]) / 3.0
                w = int(r["width"]) / 3.0
                words.append((left, w, t))
    except Exception:
        return None, ""
    words.sort()
    raw = " ".join(w[2] for w in words)
    # 坐标词 = 去掉关键词后、形如「2~3 位数字（或含 1 个字母）且含数字」的词
    cand = [w for w in words
            if 2 <= len(w[2]) <= 3 and any(ch.isdigit() for ch in w[2])
            and not re.search(r"[A-Za-z]{2,}", w[2])]
    if len(cand) < 2:
        return None, raw
    xw, yw = cand[-2], cand[-1]

    def _word_num(w):
        _shot_to("/tmp/_witp_tfl.png")
        im2 = Image.open("/tmp/_witp_tfl.png").convert("RGB")
        c = im2.crop((int(x0 + w[0]) - 1, yc - 7, int(x0 + w[0] + w[1]) + 2, yc + 7))
        c = ImageOps.autocontrast(ImageOps.grayscale(c))
        c = c.resize((c.width * 10, c.height * 10), Image.LANCZOS)
        c.save("/tmp/_wordnum.png")
        t = _ocr("/tmp/_wordnum.png", "- --psm 8 -c tessedit_char_whitelist=0123456789")
        dg = re.sub(r"\D", "", t)
        return int(dg) if dg else None
    x, y = _word_num(xw), _word_num(yw)
    if x is None or y is None:
        return None, raw
    if 10 <= x <= 250 and 10 <= y <= 250:
        return (x, y), raw
    return None, raw


def _expected_base_name(tx, ty):
    """★2026-09-26 新增★ 目标格若是基地，返回该基地名。
    用途：长距离目的地在 T 列表里显示为**基地名而非坐标**（实测 TF14 去 Townsville
    时显示 `Townsville, moveto`），坐标型回读必然判 None —— 不改的话会把
    "设对了"误判成"回读失败"，更糟的是把"设错了基地"（实测误设成 Lunga）也一起掩盖。
    """
    try:
        with open("/root/.hermes/workspace/witp-reader/state/bases.json", encoding="utf-8") as f:
            bl = json.load(f)
        for b in bl:
            if b.get("x") == tx and b.get("y") == ty:
                return b.get("name")
    except Exception:
        pass
    return None


def _base_from_dest_text(txt):
    """★2026-09-26 新增★ 从目的地文本里抠出基地名。
    目的地显示为基地时的形态是 `<基地名>, moveto` / `<基地名>, at sea` / `<基地名>. moveto`。
    实测：长距离目的地（如回澳大利亚修船）会显示基地名而不是坐标，
    此时坐标型回读必然判 None —— 不改的话 set-dest 就彻底没有反馈、原地空转。
    """
    if not txt:
        return None
    t = re.sub(r"\s+", " ", str(txt)).strip()
    # 去掉关键词，剩下前面的部分就是基地名
    t = re.sub(r"(?i)(,\s*|\s+)?(move\s*to|moveto|near\s*to|nearto|at\s*sea).*$", "", t).strip(" ,.\t")
    t = re.sub(r"[^A-Za-z ]", "", t).strip()
    return t if len(t) >= 3 else None


def _base_hex_by_name(name):
    """按基地名（容忍 OCR 噪声）在 bases.json 里反查其格坐标。"""
    if not name:
        return None
    def _c(x):
        return re.sub(r"[^a-z]", "", str(x).lower())
    key = _c(name)
    if len(key) < 3:
        return None
    try:
        with open("/root/.hermes/workspace/witp-reader/state/bases.json", encoding="utf-8") as f:
            bl = json.load(f)
    except Exception:
        return None
    best = None
    for b in bl:
        bn = _c(b.get("name"))
        if not bn:
            continue
        # 前缀/子串双向匹配（OCR 常吞尾字母，如 Townsville→Townsvi）
        if key[:6] and (key[:6] in bn or bn[:6] in key):
            x, y = b.get("x"), b.get("y")
            if isinstance(x, int) and isinstance(y, int) and 0 < x < 65535:
                best = (x, y)
                break
    return best

def _read_tf_dest_dynamic(tf_id):
    """动态读取 TF 目的地：返回 ((x,y) 或 None, 诊断dict)。

    **行校验**：只有行首编号列读出与 tf_id 相符（或包含）才认这一行；
    读不出编号的行一律跳过（**宁可失败也不读错行**）。
    """
    import sys as _s
    _s.path.insert(0, "/root/.hermes/profiles/witp/witp-agent")
    from lib import widgets as W
    from PIL import Image                      # ★必须！witp-cmd 全文件均为函数内懒加载 PIL
    ok = _shot_to("/tmp/_witp_tfl.png")
    diag = {"rows": [], "matched_y": None, "shot_ok": bool(ok), "err": None}
    p_img = "/tmp/_witp_tfl.png"
    if not os.path.exists(p_img):
        p_img = "/tmp/witp_shot.png"          # 兜底，绝不静默失败
    try:
        img = Image.open(p_img).convert("RGB")
    except Exception as e:
        diag["err"] = f"{type(e).__name__}: {e} (读 {p_img}, shot_ok={ok})"
        return None, diag
    diag["img"] = p_img
    imgL = img.convert("L")                    # 编号列逐行裁剪用（避免每行重开图）
    want = str(int(re.sub(r"\D", "", str(tf_id)) or "0"))   # 容忍 "TF15"/"tf15"/15
    # ★2026-09-26 修缺陷A★ 保留行带的**自身上下界**，裁剪时用它而不是"行心±6"。
    #   实测行距仅 14px，而 ±6 的裁剪窗高 13px，会把相邻行的字头/字尾一起裁进来
    #   → 读出 `Lunsa. moveto moveto 108.135 moveto 108.135` 这种**多行串读**，
    #   坐标被污染成 None，set-dest 随即失去反馈。
    _bands = [( (a + b) // 2, a, b ) for a, b in W.bright_row_bands(img, _TF_LIST_BOX, min_px=2)]
    for yc, _ya, _yb in _bands:
        # ★编号列：LANCZOS x6 + 裁剪 ±7★ 实测 12/12 全对（13,14,15,16,17,18,20..25）：
        #   · x8 会把 "6" 糊成 "5"（TF16→TF15），x4 会吐 "423"/"414" 之类垃圾
        #   · 裁剪 ±6 会切掉首行字形顶部（13→4），±7 才齐
        #   切勿改用 _ocr_strip 的 8x。
        from PIL import ImageOps as _IO
        _c = _IO.autocontrast(imgL.crop((_TF_ID_COL[0], yc - 7, _TF_ID_COL[1], yc + 7)))
        _c = _c.resize((_c.width * 6, _c.height * 6), Image.LANCZOS)
        _c.save("/tmp/_witp_idcol.png")
        idt = _ocr("/tmp/_witp_idcol.png",
                   "- --psm 7 -c tessedit_char_whitelist=0123456789").strip()
        idi = re.sub(r"\D", "", idt)
        # ★2026-09-26 回退★ 去掉「逐词框精读」主通道：实测它对小字号更脆
        #   （把 105,135 那类读成 `LO? 139`，连数字都保不住，反而让 set-dest 变瞎）。
        #   回到整段 OCR + _parse_dest_text（已去掉会主动制造错误的 S→5/B→8 归一）。
        #   回读本就只是便利通道，**权威核验一律以结算后读层的 target_x/y 为准**。
        _dtop, _dbot = max(0, _ya - 1), min(img.height, _yb + 2)
        dest = _ocr_strip(_TF_DEST_COL[0], _dtop, _TF_DEST_COL[1], _dbot)
        d = _parse_dest_text(dest)
        _bn = None if d else _base_from_dest_text(dest)      # ★缺陷B★ 基地名型目的地
        if d is None and not _bn:
            # ★2026-09-26 兜底★ 通用 OCR 把数字读成字母时（实测 TF16 的 `moveto LO? 141`，
            #   即 1↔L、0↔O、9↔S 这类字形歧义），用**数字白名单**再读一次强制出数字。
            #   只在通用读法拿不到坐标/基地名时才用，避免污染正常读数。
            _dnum = _ocr_strip(_TF_DEST_COL[0], _dtop, _TF_DEST_COL[1], _dbot, "0123456789")
            _dg = re.sub(r"\D", "", _dnum or "")
            if len(_dg) >= 4:
                for _a2, _b2 in ((3, 3), (3, 2), (2, 3)):
                    if len(_dg) >= _a2 + _b2:
                        _x2, _y2 = int(_dg[:_a2]), int(_dg[_a2:_a2 + _b2])
                        if 10 <= _x2 <= 250 and 10 <= _y2 <= 250:
                            d = (_x2, _y2)
                            diag.setdefault("num_fallback", []).append((yc, _dnum))
                            break
        diag["rows"].append({"y": yc, "id_read": idi, "dest_text": dest[:40],
                             "dest": d, "base_name": _bn})
        if idi == want or (idi and want in idi):
            # ★2026-09-26 多采样投票★ 目标列 OCR 会在 **9 与 S、5 之间摇摆**
            #   （实测 TF14 真值 109 被读成 "10S"，而 S→5 归一又把它变成假的 105，
            #    直接导致"set-dest 报收敛成功、核验脚本却读回不符"的矛盾）。
            #   故对命中行重复读取 3 次、取**多数一致**的解析；不一致则报 None（不猜）。
            votes = {}
            d0 = d
            if d0:
                votes[tuple(d0)] = votes.get(tuple(d0), 0) + 1
            for _k in range(2):
                _shot_to("/tmp/_witp_tfl.png")
                _t = _ocr_strip(_TF_DEST_COL[0], yc - 6, _TF_DEST_COL[1], yc + 6)
                _d = _parse_dest_text(_t)
                diag["rows"].append({"y": yc, "id_read": idi, "dest_text": _t[:40],
                                     "dest": _d, "resample": _k + 2})
                if _d:
                    votes[tuple(_d)] = votes.get(tuple(_d), 0) + 1
            if votes:
                best, cnt = max(votes.items(), key=lambda kv: kv[1])
                if cnt >= 2 and len(votes) > 1:
                    print(f"[witp-cmd] ⓘ TF{tf_id} 目标列多次读数不一致 {list(votes)}"
                          f" → 取多数 {best}（OCR 在 9/S、5 间摇摆）")
                elif len(votes) > 1 and cnt < 2:
                    print(f"[witp-cmd] ⚠️ TF{tf_id} 目标列读数全不一致 {list(votes)}"
                          f" → **判为读不出**（不猜）")
                    diag["matched_y"] = yc
                    return None, diag
                diag["matched_y"] = yc
                return tuple(best), diag
            diag["matched_y"] = yc
            diag["base_name"] = _bn
            return None, diag
    return None, diag


def _verify_tf_dest_dynamic(tf_id, tx, ty):
    """用动态读取核验目的地是否为 (tx,ty)。返回 (是否精确一致, 实际值或None)。"""
    d, diag = _read_tf_dest_dynamic(tf_id)
    if d is None:
        return False, None
    return (int(d[0]) == int(tx) and int(d[1]) == int(ty)), d


def _verify_tf_dest(tf_id, tx, ty):
    """回读编队列表的目的地列，确认指令已生效。

    ★纪律（教条 #46）★ 判据必须**精确相等**：
      旧版 `abs(dx-tx)<=1` 的 ±1 容差把偏差洗成了"✓ 已确认"，第十二局据此
      误判了整整一局。容差=0 才是核验。
    ★纪律（教条 #49）★ 行定位必须**动态**：旧 `_read_tf_dest_from_list` 用写死的
      ROW_YS + 行序表，既绑死剧本，也是"TF16 读出 TF17 目标"的根源。
      读不出本人行 → 直接判失败（**宁可失败也不读错行**）。
    """
    d, _diag = _read_tf_dest_dynamic(tf_id)
    if d is None:
        return False
    return int(d[0]) == int(tx) and int(d[1]) == int(ty)

