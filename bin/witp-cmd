def cmd_set_dest(args):
    """设置编队目的地。

    ★2026-10-03 真实机制（逐帧取证，推翻此前多版错误前提）★
      ① T 开编队列表 → 双击目标行 → 编队详情面板。
      ② 点 `Set TF Destination` 标题左侧箭头（≈ Destination 词左边界 −45px）
         → ★面板立即关闭★（ui_state='map'），进入选格模式。
      ③ 在整张地图任意像素点击 → 目的地设定，★面板自动重开★显示新目的地。
         ⇒ **选格时全屏可点，不存在面板遮挡**（此前"遮挡带"结论已作废）。
      ④ 核验：面板回读 `Hex: x,y`（基地格显示 `<基地名>-x,y`，无 Hex 前缀）。
      最终权威仍是结算后读层 target_x/target_y。
    实现见 lib/setdest14.py（视野内）/ setdest13.py（同，无滚动）。
    """
    try:
        import sys as _s
        _s.path.insert(0, "/root/.hermes/profiles/witp/witp-agent")
        try:
            from lib import setdest14 as _sd   # ★2026-10-03 定稿：视野内单探针+已知比例；
        except Exception:                       #   视野外走边缘滚动（2.5 格/秒）
            from lib import setdest13 as _sd
    except Exception as _e:
        print(f"[witp-cmd] ❌ set-dest 模块加载失败: {_e}")
        sys.exit(1)
    ok, last = _sd.set_tf_dest(args.tf_id, args.hex_x, args.hex_y,
                               deadline=float(getattr(args, "deadline", 140) or 140))
    if ok:
        print(f"[witp-cmd] ✓ 编队 {args.tf_id} 目的地 = {last}"
              f"（面板回读确认；最终以结算后读层核验）")
    else:
        print(f"[witp-cmd] ❌ 编队 {args.tf_id} 未能确认目的地 = ({args.hex_x},{args.hex_y})"
              f"（末次面板读数 {last}）—— 以结算后读层为准。")
        sys.exit(1)


# ★2026-09-24 新增：CAP 高度控制（实测标定）★
#   航空队详情内 "Current Altitude" 行 y≈372，控件行 y≈387。
#   逐像素扫描实测的按钮语义（Δ 为点击后高度变化）：
#     x=647 → 直接设为最低 100 ft        x=667 → 设为 1000 ft
#     x=732 → +1000 ft                   x=752 → +5000 ft
#     x=772 → 直接设为最高（机型上限）
ALT_Y = 387
ALT_MIN, ALT_SET1K, ALT_P1K, ALT_P5K, ALT_MAX = 647, 667, 732, 752, 772


def _read_alt():
    """读取详情面板 Current Altitude 数值。

    ★2026-09-24 校准★ 整行宽裁剪会让 OCR 把 6 读成 S（实测 "6000"→"S000"）。
    改为**只裁数值本体** (720,364)-(768,388) 并放大 10 倍 + 数字白名单，
    实测 "6000" 稳定识别。
    """
    from PIL import Image, ImageOps
    _shot_to("/tmp/_alt_read.png")
    im = Image.open("/tmp/_alt_read.png").crop((720, 364, 768, 388))
    im = ImageOps.autocontrast(ImageOps.grayscale(im)).resize((im.width * 10, im.height * 10), Image.LANCZOS)
    im.save("/tmp/_alt_read_z.png")
    for _a in ("- --psm 7 -c tessedit_char_whitelist=0123456789", "- --psm 7", "- --psm 8", "- --psm 13"):
        t = _ocr("/tmp/_alt_read_z.png", _a)
        m = re.search(r"\d{3,5}", t)
        if m:
            return int(m.group(0))
    return None


def _set_altitude(target):
    """把当前打开的中队详情中的 CAP 高度设为目标英尺。

    实测按钮语义见上；实现为「归最低 → 置 1000 → 用 +5000/+1000 步进逼近」，
    每步都读回校验，读失败则重试（不盲加，避免超调）。
    """
    target = int(target)
    vnc_click(ALT_MIN, ALT_Y, "click"); time.sleep(0.9)
    if target <= 100:
        return _read_alt()
    vnc_click(ALT_SET1K, ALT_Y, "click"); time.sleep(0.9)
    for _ in range(40):
        cur = _read_alt()
        if cur is None:
            time.sleep(0.5)
            continue
        if cur == target:
            return cur
        gap = target - cur
        if gap >= 5000:
            vnc_click(ALT_P5K, ALT_Y, "click")
        elif gap >= 1000:
            vnc_click(ALT_P1K, ALT_Y, "click")
        else:
            return cur
        time.sleep(0.9)
    return _read_alt()


def _find_cap_row_y():
    """在航空队详情屏右侧「Patrol levels」区定位 'CAP' 行的 y 中心。

    ★2026-10-14 新增（修 CAP 行 y 写死缺陷）★
      详情屏该区各行 y 随中队装备/机型行数浮动（实测同一局不同中队 CAP 行
      可落在 y≈303 或 y≈316）。写死 CAP_Y=303 会对部分中队点空。
    ★两级定位★
      ① 主：OCR 面板找 'LRCAP' 词（CAP 行恒在其上 14px；LRCAP 字形更易读）；
      ② 备：OCR 找 'CAP'/'CRP' 等词。
      找不到返回 None（调用方回退 303）。
    """
    from PIL import Image, ImageOps
    import csv as _csv
    _shot_to("/tmp/_caprow.png")
    try:
        im = Image.open("/tmp/_caprow.png").convert("RGB")
    except Exception:
        return None
    box = (600, 280, 900, 440)          # Patrol levels 区
    c = ImageOps.autocontrast(ImageOps.grayscale(im.crop(box)))
    c = c.resize((c.width * 5, c.height * 5), Image.LANCZOS)
    c.save("/tmp/_caprow_t.png")
    subprocess.run("tesseract /tmp/_caprow_t.png /tmp/_caprow --psm 6 tsv 2>/dev/null", shell=True)
    try:
        rows = list(_csv.DictReader(open("/tmp/_caprow.tsv"), delimiter="\t", quoting=_csv.QUOTE_NONE))
    except Exception:
        return None
    # ① LRCAP 锚点
    for r in rows:
        tu = (r.get("text") or "").strip().upper()
        if "LRCAP" in tu or "LRC" in tu or "RCA" in tu:
            yc = int(r["top"]) / 5.0 + int(r["height"]) / 10.0 + box[1]
            return int(round(yc)) - 14
    # ② CAP 词
    for r in rows:
        tu = (r.get("text") or "").strip().upper()
        if tu in ("CAP", "CRP", "GAP", "CEAP"):
            yc = int(r["top"]) / 5.0 + int(r["height"]) / 10.0 + box[1]
            return int(round(yc))
    return None


def _read_cap_pct():
    """读取航空队详情面板 CAP 行的百分比数值。

    ★2026-10-14 修★ 原读数窗口写死 (704,297)-(745,311)（实测那是 ASW 行），
      改为**跟随 _find_cap_row_y() 定位的行**读同一行的数值区。
    """
    from PIL import Image, ImageOps
    _shot_to("/tmp/_capread.png")
    try:
        im = Image.open("/tmp/_capread.png").convert("RGB")
    except Exception:
        return None
    yc = _find_cap_row_y() or 303
    # ★2026-10-15 修（读数窗口按实测重标）★
    #   实测 EI-1 详情屏：CAP 行 y=298、值「80%/100%」在 x≈719、
    #   百分比符号紧随其后（x≈735）。原窗口 (725,±6) 落在 % 号右侧空白，
    #   故常读成空 → 被误判「没设上」。
    #   新窗口覆盖 705..765，含数字与 %，显著提高读出率。
    im2 = im.crop((705, yc - 7, 765, yc + 7))
    im2 = ImageOps.autocontrast(ImageOps.grayscale(im2)).resize((im2.width * 10, im2.height * 10),
                                                                Image.LANCZOS)
    im2.save("/tmp/_capread_z.png")
    txt = _ocr("/tmp/_capread_z.png", "- --psm 7 -c tessedit_char_whitelist=0123456789")
    m = re.search(r"\d{1,3}", txt)
    return int(m.group(0)) if m else None


def _is_carrier_group(ag_id: str) -> bool:
    """判断航空队是否**舰载**（零硬编码，阵营无关）。

    ★依据读层权威数据：航母（CV/CVL/CVE）记录的 `airgroups` 子名单。
      任一名字与之匹配即判为舰载。这样盟军（VF-/VB-…）与日军
      （EI-1 Daitai / EIII-1 Chutai …）都不需要写死前缀。

    匹配规则：读层名字与查询名做「全等」或「双向 startswith」归一化比较
    （读层名有时带尾随空格/编号后缀）。
    """
    def _norm(s):
        return re.sub(r"[^A-Z0-9]", "", str(s).upper())

    t = _norm(ag_id)
    if not t:
        return False
    try:
        with open("/root/.hermes/workspace/witp-reader/state/ships.json",
                  encoding="utf-8") as f:
            ships = json.load(f)
        ships = ships if isinstance(ships, list) else ships.get("ships", [])
    except Exception:
        return False
    for s in ships:
        if str(s.get("ship_class_type_name")) not in ("CV", "CVL", "CVE"):
            continue
        for g in (s.get("airgroups") or []):
            n = _norm(g.get("name"))
            if n and (n == t or n.startswith(t) or t.startswith(n)):
                return True
    return False


def _cap_from_state(ag_id: str):
    """★2026-10-15 新增★ 从**存档读层** airgroups.json 读该中队的 percent_cap。

    动机：详情屏 OCR 回读（`_read_cap_pct`）在本环境经常读不出 →
    误报"CAP 未设上"。教条明确「UI 回读只是过程证据，唯一最终权威是读层」，
    故这里给 set-cap 一个可靠的权威判据来源。

    匹配：读层名字与查询名做归一化（去非字母数字、大写）后全等或双向 startswith。
    """
    try:
        with open("/root/.hermes/workspace/witp-reader/state/airgroups.json",
                  encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        return None
    ags = data if isinstance(data, list) else data.get("airgroups", [])

    def _norm(s):
        return re.sub(r"[^A-Z0-9]", "", str(s).upper())

    t = _norm(ag_id)
    if not t:
        return None
    for g in ags:
        n = _norm(g.get("name"))
        if n and (n == t or n.startswith(t) or t.startswith(n)):
            v = g.get("percent_cap")
            return int(v) if v is not None else None
    return None


def cmd_set_cap(args):
    """设置航空队 CAP 百分比（舰载 N / 陆基 A 自适应）。

    ★2026-09-24 修复（三项致命错误）★
      1) 开详情方式：N 列表 = **单击图标列 x=190**；A 列表 = 双击 x=215。
         旧代码对两者统一用双击 x=215 → 舰载中队全部打不开详情，CAP 从未真正设置成功。
      2) CAP 按钮语义（实测）：x=651 直接归零 / x=671 每次 −10 / x=746 每次 +10 / x=767 直接设 100。
         旧代码用 x=766 连点 pct//20 次 → 数值完全错。
      3) 新增读回核验：改完立刻重读 CAP 数值，与目标不符则告警。
    """
    ag_id = args.ag_id
    pct = int(args.percent)
    # ★2026-09-29 修复（换阵营暴露）★ 原判据写死盟军中队名前缀
    #   `["VF-","VB-","VS-","VT-","VCS-"]` —— 日军舰载中队叫 `EI-1 Daitai`
    #   /`EIII-1 Chutai`，**一个都不匹配** → 被误判为陆基 → 去陆基列表 (A) 找
    #   → 必然"定位失败"，而调用方（set-cap-all）仍把它记成 done（假成功）。
    #   改为**读层权威判据**：凡出现在我方航母 `airgroups` 名单里的中队即舰载，
    #   与阵营命名无关（零硬编码）。
    is_naval = _is_carrier_group(ag_id)
    list_key = "n" if is_naval else "a"
    # ★2026-10-14 新增 --list 强制指定★ 读层 airgroups.json 有时**漏掉某些舰载机队**
    #   （实测只导出 Shokaku 的 EI-*，漏掉 Zuikaku/Shoho 的 EII/EIII），
    #   导致 _is_carrier_group 判成陆基 → 去 A 列表找不到。允许显式指定列表。
    if getattr(args, "list", None):
        list_key = args.list
        is_naval = (list_key == "n")
    list_name = "舰载机列表 (N)" if list_key == "n" else "陆基列表 (A)"
    print(f"[witp-cmd] 执行指令：将中队 {ag_id} CAP 设定为 {pct}%（{list_name}）...")

    focus_map()
    vnc_key(list_key)
    time.sleep(3.0)

    row_y = getattr(args, "row", None) or _find_airgroup_row(ag_id, list_key)
    if row_y is None:
        print(f"[witp-cmd] ❌ 未能在 {list_name} 定位中队 {ag_id}！中止操作。")
        vnc_key("escape")
        return

    how = "单击 x=190" if is_naval else "双击 x=215"
    print(f"[witp-cmd] 打开中队详情 (行 y={row_y}，{how})...")
    if is_naval:
        vnc_click(190, row_y, "click")
    else:
        vnc_click(215, row_y, "dblclick")
    time.sleep(3.0)

    before = _read_cap_pct()
    print(f"[witp-cmd] 当前 CAP = {before}")

    # ★★2026-10-15 修（--row 只作用于列表行、不作用于 CAP 滑块行）★★
    #   实测：`--row 321`（列表行）能让详情屏正确打开，但 CAP 滑块行仍回退到
    #   写死的 303 ⇒ 点击落在错误行 ⇒ 设不上（EI-1 反复失败的第二个原因）。
    #   详情屏「Patrol levels」各行与**列表行**存在稳定偏移：实测
    #     列表 y=321 → CAP 行 y≈335（偏移 +14×2=+28~+42 视面板行数）。
    #   由于偏量不稳定，这里按 **列表行 + 42 试算**，并由 _find_cap_row_y()
    #   的 OCR 结果优先；两者都不行才回退 303。
    #   另新增 --cap-row 供直接指定（最可靠）。
    cap_row_override = getattr(args, "cap_row", None)
    if cap_row_override:
        CAP_Y = int(cap_row_override)
        print(f"[witp-cmd] CAP 行 y = {CAP_Y}（--cap-row 显式指定）")
    else:
        _ocr_cap = _find_cap_row_y()
        if _ocr_cap:
            CAP_Y = _ocr_cap
            print(f"[witp-cmd] CAP 行 y = {CAP_Y}（OCR 定位）")
        elif getattr(args, "row", None):
            CAP_Y = int(args.row) + 42
            print(f"[witp-cmd] CAP 行 y = {CAP_Y}（由列表行 {args.row} + 42 试算）")
        else:
            CAP_Y = 303
            print(f"[witp-cmd] CAP 行 y = {CAP_Y}（回退默认值）")

    # ★★2026-10-14 修（CAP 行 y 写死致 Shokaku 组设不上）★★
    #   旧实现 CAP_Y = 303 是**写死值**，但详情屏「Patrol levels」区各行 y 会随
    #   该中队装备/机型行数浮动（实测同一局 Zuikaku 战斗机 CAP 行在 y≈323，
    #   而写死的 303 是另一中队的行位）⇒ 对 y 不同的中队点 303 会点到 ASW 行，
    #   CAP 永远设不上（这正是 game-054 里 EI-1/EII-1 反复失败、导致 Zuikaku
    #   被击沉的真因）。
    #   ⇒ 改为 **OCR 动态定位 CAP 行**（见上方 2026-10-15 块，含 --cap-row 与
    #      「列表行 +42」试算两条兜底）。此处不再重复赋值。
    if pct <= 0:
        vnc_click(651, CAP_Y, "click"); time.sleep(0.6)
    elif pct >= 100:
        vnc_click(767, CAP_Y, "click"); time.sleep(0.6)
    else:
        # ★2026-09-29 修复★ 确定性路径：先「归零」(x=651)，再从 0 逐次 +10 到目标。
        vnc_click(651, CAP_Y, "click"); time.sleep(0.6)
        base = _read_cap_pct()
        if base is not None and base != 0:
            print(f"[witp-cmd] ⚠️ 归零后读回 {base}（预期 0）—— 继续按差值步进")
        steps = int(round(pct / 10.0))
        for _ in range(steps):
            vnc_click(746, CAP_Y, "click"); time.sleep(0.35)
    time.sleep(1.0)

    # ★2026-09-24 新增★ CAP 分层高度（--alt）：详情面板保持打开时设置
    alt_got = None
    if getattr(args, "alt", None):
        alt_got = _set_altitude(args.alt)
        print(f"[witp-cmd] CAP 高度 → 读回 {alt_got} ft（目标 {args.alt} ft）")

    after = _read_cap_pct()
    vnc_key("escape")
    time.sleep(1.5)

    # ★2026-10-15 修（CAP 长期"设上了却报失败"的真因）★
    #   `_read_cap_pct()` 是**详情屏 OCR**，本环境下经常读不出（返回 None）
    #   → `ok_cap=False` → 打印"未达目标，不视为成功"。
    #   但指令其实**已经下发且生效**（实测 game-059：报 3 个中队全失败，
    #   存档读层 percent_cap 却是 80/80/80）。
    #   这与教条一致：**UI 回读只是过程证据，唯一最终权威是结算后读层**。
    #   ⇒ OCR 失败时改查存档读层的 percent_cap 作为权威判据。
    authoritative = None
    if after is None:
        authoritative = _cap_from_state(ag_id)
        if authoritative is not None:
            after = authoritative

    # ★2026-09-29 修复★ 原判据 `abs(after - pct) <= 10` **带 ±10 容差** ——
    #   正是教条禁止的「判据带容差」：实测把 CAP=55（目标 60）报成"✓ 成功"。
    #   改为**精确相等**：必须 after == pct 才算成功，否则明确报 FAILED。
    ok_cap = (after is not None and after == pct)
    ok_alt = (not getattr(args, "alt", None)) or (alt_got is not None and alt_got == args.alt)
    if ok_cap and ok_alt:
        src = "存档读层" if authoritative is not None else "详情屏回读"
        msg = f"✓ 中队 {ag_id} CAP = {after}%（目标 {pct}%，判据来源={src}）"
        if getattr(args, "alt", None):
            msg += f"，高度 = {alt_got} ft（目标 {args.alt} ft）"
        print(f"[witp-cmd] {msg} —— 确认生效。")
    else:
        print(f"[witp-cmd] ❌ 中队 {ag_id} CAP 读回 {after}%（目标 {pct}%）"
              f"、高度读回 {alt_got}（目标 {getattr(args,'alt',None)}）"
              f"—— **未达目标，不视为成功**。")
        # ★2026-10-15★ 指令已下发、但拿不到任何回读时，不得静默判死：
        #   提示上层用存档读层复核（唯一权威），而不是当作"没设上"重来。
        if after is None:
            print("[witp-cmd] ⚠ 注意：本次**未能取得任何回读**（详情屏 OCR 失败）。"
                  "指令已下发；请以存档读层 airgroups.json 的 percent_cap 为唯一权威判据，"
                  "不要据此推断'没设上'。")


def cmd_set_cap_all(args):
    """★2026-09-29 新增★ 批量设置：按前缀枚举所有同级中队。

    动机：第十八局只设了 VF-5（约克敦），漏设 VF-2（列克星敦）→ 列克星敦维持
    剧本默认 30% CAP，被 3 条鱼雷重创。⇒ 航母 CAP 必须**逐中队全部设定**，
    不能只设当前选中编队的那一艘。

    用法: witp-cmd set-cap-all VF 60        # 所有 VF-* 中队
          witp-cmd set-cap-all VF,VCS 60    # 多个前缀
    枚举来源：读层 airgroups.json（权威），不靠界面扫描。
    """
    prefixes = [p.strip().upper() for p in args.prefix.split(",") if p.strip()]
    pct = int(args.percent)
    state = "/root/.hermes/workspace/witp-reader/state/airgroups.json"
    try:
        with open(state, encoding="utf-8") as f:
            raw = json.load(f)
    except Exception as e:
        print(f"[witp-cmd] ❌ 读层 airgroups.json 不可用：{e}")
        return
    groups = raw if isinstance(raw, list) else (
        raw.get("air_groups") or raw.get("data") or [])
    targets = []
    for r in groups:
        name = str(r.get("name") or "")
        up = name.upper()
        if any(up.startswith(p) for p in prefixes):
            targets.append(name)
    # 去重保序
    seen = set()
    targets = [t for t in targets if not (t in seen or seen.add(t))]
    if not targets:
        print(f"[witp-cmd] ❌ 读层找不到前缀 {prefixes} 的中队")
        return
    print(f"[witp-cmd] 批量设 CAP：{len(targets)} 个中队 → {pct}%")
    print(f"           目标：{targets}")
    results = {}
    for t in targets:
        ns = argparse.Namespace(ag_id=t, percent=pct,
                                row=None, alt=getattr(args, "alt", None))
        try:
            # ★2026-09-29 修复★ 原先无条件记 "done"，即使 cmd_set_cap 内部
            #   "定位失败→return" 也照样算成功 → **假成功**（实测 2/4 中队
            #   根本没设，汇总却报 4/4 done）。现改为：
            #   捕获 stdout，检出失败标志词即记 failed，绝不静默当成功。
            import io
            import contextlib
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                cmd_set_cap(ns)
            out = buf.getvalue()
            print(out, end="")
            if ("❌" in out) or ("未能在" in out) or ("中止" in out):
                results[t] = "FAILED"
            else:
                results[t] = "done"
        except Exception as e:
            results[t] = f"err:{e}"
    nfail = sum(1 for v in results.values() if v != "done")
    print(f"\n[witp-cmd] 批量结果：{results}")
    if nfail:
        print(f"[witp-cmd] ⚠️ 有 {nfail}/{len(results)} 个中队**未成功**"
              f"（见上方 ❌ 行）——不得视为全部完成。")
    print(f"[witp-cmd] ★ 最终判据仍为结算后读层 airgroups.json 的 percent_cap"
          f"（指令层读回不算数）。")

# ============================================================================
# set-search：对海搜索 / 反潜搜索比例
#   指挥官指正（2026-09-25）：十二局从未发现敌航母 = 侦察策略有缺陷；
#   根因之一是「搜索从未成为可执行命令」（recon_guidance 只是散文）。
#
#   ⚠️⚠️ 航空队详情面板的行坐标**会随面板内容位移**——把 Search 设为非 0 会露出
#      搜索弧控件（Start OGC / End OGC / Reset arc），Search/Train/Rest 整块下移；
#      同一面板在不同状态下**行序甚至不同**。故**严禁硬编码 y**，
#      一律在运行时用 OCR 定位「Patrol levels」区块内的目标行，再像素扫描定位按钮。
# ============================================================================
_PANEL_X0, _PANEL_X1 = 645, 900
# ★2026-10-01 修（换阵营+换列表暴露的「标定写死」缺陷）★
#   原常量 300..465 是按 **N 列表（舰载）** 详情屏标定的；
#   实测 **A 列表（陆基）** 详情屏的搜索控制区整体上移到 y≈160..210
#   （关键字 Naval/ASW/Patrol 实测出现在 (668,166)/(667,204)/(802,197)）。
#   写死一个 y 带必然漏掉另一侧 ⇒ 改为**覆盖整个右侧控制区**，由关键字自适应命中；
#   取词框时用「与关键字同一行的按钮」而非固定行号。
_PANEL_Y0, _PANEL_Y1 = 120, 560


def _panel_tokens():
    """OCR 详情面板右侧，返回 [(row_y, x_left, text)]（游戏坐标）。"""
    from PIL import Image, ImageOps
    import csv as _csv
    _shot_to("/tmp/_panel.png")
    im = Image.open("/tmp/_panel.png").crop((_PANEL_X0, _PANEL_Y0, _PANEL_X1, _PANEL_Y1))
    im = ImageOps.autocontrast(ImageOps.grayscale(im)).resize((im.width * 4, im.height * 4), Image.LANCZOS)
    im.save("/tmp/_panel_z.png")
    subprocess.run("tesseract /tmp/_panel_z.png /tmp/_panel_z --psm 6 tsv 2>/dev/null", shell=True)
    out = []
    try:
        with open("/tmp/_panel_z.tsv") as f:
            for r in _csv.DictReader(f, delimiter="\t"):
                t = (r.get("text") or "").strip()
                if not t:
                    continue
                try:
                    conf = float(r.get("conf") or -1)
                except Exception:
                    conf = -1
                if conf < 20:
                    continue
                y = _PANEL_Y0 + int(int(r["top"]) // 4) + 6
                x = _PANEL_X0 + int(int(r["left"]) // 4)
                out.append((y, x, t))
    except Exception:
        pass
    return out


def _locate_panel_row(label):
    """按标签 (Search / ASW / Train / Rest) 定位行 y；容忍 OCR 噪声（如 'Search5o'）。"""
    key = label.lower().replace(" ", "")
    toks = _panel_tokens()
    cand = [t for t in toks if key in t[2].lower().replace(" ", "")]
    if not cand:
        return None
    cand.sort(key=lambda t: t[0])
    return cand[-1][0]          # 取最下方者（Patrol levels 区块位于面板下半部）


def _row_button_xs(y):
    """在行带内定位 4 个按钮的 x。

    ⚠️ 不能用「最右两簇」——当该行附近出现搜索弧文字（Start OGC/End OGC）时，
    行内会多出右侧文字簇，导致把非按钮当按钮（实测把 VP-11 的 +100 点错）。
    左侧两按钮位置稳定（实测恒为 652/671），故**以左对为基准、按实测偏移推出右对**：
      →100 = 左对首项 + 111、 +10 = 左对首项 + 90   （652→763、652→742）
    """
    from PIL import Image
    _shot_to("/tmp/_row.png")
    im = Image.open("/tmp/_row.png").convert("L")
    px = im.load()
    y0, y1 = max(0, y - 7), min(im.height, y + 7)
    runs, cur = [], None
    for x in range(_PANEL_X0, _PANEL_X1):
        n = sum(1 for yy in range(y0, y1) if px[x, yy] > 140)
        if n >= 1:
            if cur and x - cur[1] <= 2:
                cur[1] = x
            else:
                if cur:
                    runs.append(cur)
                cur = [x, x]
    if cur:
        runs.append(cur)
    if len(runs) < 2:
        return None
    mid = lambda r: (r[0] + r[1]) // 2
    # ★2026-10-01 修（换列表暴露的「偏移写死」缺陷）★
    #   原按左对首项 +90/+111 推右对 —— 那是 **N 列表（舰载）** 的标定
    #   （实测 652/671/742/763）。**A 列表（陆基）** 实测为 653/697/743/764，
    #   偏移不同 ⇒ 陆基中队「能设上但读回 None」，误报未确认。
    #   改为：若行内检出 ≥4 个亮度簇，**直接取四簇**；否则回落偏移法（兼容舰载屏）。
    # ★2026-10-04 修（set-search 值卡在 50/20 上不去 100 的真因）★
    #   原「检出 ≥4 簇就直接取四簇」是错的：陆基屏实测簇为 652/671/700/722，
    #   其中 **700/722 不是 +10/+100 按钮**。真按钮在 zero+90 / zero+111
    #   （两种列表实测一致：N 列表 652→742/763，A 列表 653→743/764）。
    #   取错按钮 ⇒ 点「+100」实际点到别处 ⇒ 值停在 50/20 上不去。
    #   改为：**恒定按 zero 推 plus/full**，簇只用来定 zero / minus。
    zx = mid(runs[0])
    minus = mid(runs[1])
    return {"zero": zx, "minus": minus,
            "plus": zx + 90, "full": zx + 111,
            "clusters": runs}


def _read_row_pct(y, buttons):
    """读取该行数值：取「标签簇之后、+10 按钮之前」的文字簇。

    ★2026-09-26 加固★ 原实现有两个毛病，导致 set-search 长期"读回 None → 判未确认"：
      ①裁剪起于 inner 簇首，实测会把标签尾字一并裁进来（裁出 `search 10C`）；
      ②OCR 把 **C 读成 0 的反向**（"100"→"10C"），而原实现只取 `\\d{1,3}` 首段，
        会得到 "10" 甚至拿不到，于是明明设成功也报"未确认"。
      改为：按按钮基准定死数值区（minus+12 .. plus-2）、数字白名单、
      再把 C/O→0、S→5、I/L→1、B→8、G→6 归一后取全部数字。
      （实测 VS-5 的 Search 经视觉确认为 100，本函数修好后才读得出。）
    """
    from PIL import Image, ImageOps
    if not buttons:
        return None
    x0 = buttons["minus"] + 12
    x1 = buttons["plus"] - 2
    # ★2026-10-04 修（set-search 长期"设上了却读回 2/3 判未确认"的真因）★
    #   陆基屏（A 列表）实测簇识别会多出右侧文字簇，把非按钮当按钮
    #   （实测簇 = 652/671/700/725），于是读数窗口只剩 683..698 共 15px，
    #   OCR 必然读出垃圾数字（2、3）。窗口过窄即判为簇识别有误，
    #   回落到按 zero 按钮推的基准几何（实测两种列表的数值区都在 zero+30..zero+95）。
    if x1 - x0 < 25:
        z = buttons.get("zero", 652)
        x0, x1 = z + 30, z + 95
    if x1 - x0 < 8:
        return None
    _shot_to("/tmp/_rv.png")
    im = Image.open("/tmp/_rv.png").crop((x0, y - 7, x1, y + 7))
    im = ImageOps.autocontrast(ImageOps.grayscale(im)).resize((im.width * 10, im.height * 10), Image.LANCZOS)
    im.save("/tmp/_rv_z.png")
    raw = _ocr("/tmp/_rv_z.png", "- --psm 7 -c tessedit_char_whitelist=0123456789COoSsIlLBG")
    t = raw.upper().replace("C", "0").replace("O", "0").replace("S", "5") \
                 .replace("I", "1").replace("L", "1").replace("B", "8").replace("G", "6")
    digits = re.sub(r"\D", "", t)
    if not digits:
        return None
    v = int(digits)
    return v if 0 <= v <= 100 else None


def _panel_is_open(toks=None):
    """判定航空队详情面板是否已打开：用 Patrol levels 区块的行名做多关键字判定。
    ⚠️ 不要只认 'Patrol levels' 标签——它是黄字，常被 TSV 置信度过滤掉（实测踩坑）。"""
    toks = toks if toks is not None else _panel_tokens()
    blob = " ".join(t[2].lower().replace(" ", "") for t in toks)
    return sum(k in blob for k in ("search", "asw", "train", "rest", "arc")) >= 2


def _open_ag_detail(ag_id, list_key, row_override=None, list_already_open=False):
    """打开航空队详情；返回 (是否成功, 行 y)。N 列表单击 x=190，A 列表单击 x=200。
    ⚠️ 清单行的 y 在两次测量间会有 ±6px 抖动，故对给定行做邻近重试。
    ★2026-10-04 修①★ 重试候选原为 ±(6,6,12,12,3,3)px，最大偏 12px。
      行高仅 14px，偏 12px 就点到**相邻行**（实测 VS-2 从 427 偏到 341，
      跨了 6 行 ⇒ 改错部队）。收窄为 ±(2,4,6)，最大不超半个行高。
    ★2026-10-04 修②★ `list_already_open=True` 时**不再按 list_key**。
      实测 --row-index 通道已在外部开过列表并据此数出行峰；这里再按一次
      会把列表关掉再重开，行 y 随之平移（实测 427 → 341），
      于是按行号的定位全部作废。"""
    focus_map()
    if not list_already_open:
        vnc_key(list_key)
        time.sleep(3.0)
    else:
        time.sleep(0.8)
    row = row_override if row_override else _find_airgroup_row(ag_id, list_key)
    if row is None:
        vnc_key("escape")
        return False, None
    candidates = [row] + [row + d for d in (-2, 2, -4, 4, -6, 6)]
    for r in candidates:
        vnc_click(190 if list_key == "n" else 200, r, "click")
        time.sleep(2.2)
        toks = _panel_tokens()
        if _panel_is_open(toks):
            return True, r
        vnc_click(215, r, "dblclick")       # 兜底：双击
        time.sleep(2.2)
        if _panel_is_open(_panel_tokens()):
            return True, r
    return False, row


def cmd_set_search(args):
    """设定航空队对海搜索 / 反潜搜索比例（含自纠正与读回核验）。"""
    ag = args.ag_id
    pct = max(0, min(100, int(args.percent)))
    label = "ASW" if getattr(args, "asw", False) else "Search"
    # ★2026-10-01 修（换阵营暴露的「写死单侧」缺陷）★
    #   原判据写死盟军前缀 VF-/VB-/VS-/VT-/VCS- ⇒ 日军中队（`EI-1 Daitai`/
    #   `Toko Ku T-1 Det`/`17th Ku T-1`）**全部被判为陆基**，但真正的问题在于：
    #   日军舰载中队走 N 列表、陆基走 A 列表，写死前缀会让舰载中队去 A 列表找 → 打不开。
    #   改为**读层权威判据** `_is_carrier_group`（看 stationed_on_ship_id）。
    try:
        from witp_ground_orders import _is_carrier_group as _icg2
        is_naval = bool(_icg2(ag))
    except Exception:
        is_naval = any(k in ag.upper() for k in ["VF-", "VB-", "VS-", "VT-", "VCS-"])
    list_key = "n" if is_naval else "a"
    print(f"[witp-cmd] 设定 {ag} 的 {label} = {pct}%"
          f"（{'舰载 N' if is_naval else '陆基 A'} 列表，运行时动态定位面板行）...")

    # ★2026-10-04 新增：--row-index 纯像素行序通道（N 列表 OCR 认不出队名时唯一可用）★
    row_override = getattr(args, "row", None)
    ridx = getattr(args, "row_index", None)
    if ridx is not None:
        # ★必须先开对应列表再截图★：否则截到的是地图，行峰自然只有 0~1 个。
        focus_map()
        vnc_key(list_key)
        time.sleep(3.0)
        _shot_to("/tmp/_ri.png")
        try:
            from PIL import Image
            from lib.executor import get_window_offset
            _ox, _oy = get_window_offset()
            _im = Image.open("/tmp/_ri.png").crop((_ox, _oy, _ox + 1024, _oy + 768))
            _im.save("/tmp/_ri_w.png")
            from lib.rowfind import find_rows
            _rows = find_rows("/tmp/_ri_w.png")
        except Exception as e:
            _rows = []
            print(f"[witp-cmd] ⚠️ 像素行定位失败: {e}")
        print(f"[witp-cmd] · 像素行峰（共 {len(_rows)} 行）: "
              f"{[y for y, _ in _rows]}")
        if 0 <= ridx < len(_rows):
            row_override = _rows[ridx][0]
            print(f"[witp-cmd] · --row-index {ridx} → 行中心 y={row_override}")
        else:
            print(f"[witp-cmd] ❌ --row-index {ridx} 越界（共 {len(_rows)} 行），"
                  f"中止（列表是否未打开？）。")
            vnc_key("escape")
            return

    # ★2026-10-10 重写（set-search 长期失效的真因）★
    #   旧路径：`_open_ag_detail(ag, ...)` 内部按 list_key 开列表 → `_find_airgroup_row`
    #   定位 → 点行开详情屏。但随后 `_locate_panel_row(label)` 走 `_panel_tokens()`，
    #   **实测读数恒为 None** —— 根因有二：
    #     ① `_find_airgroup_row` 依赖当前屏幕**已经是列表屏**；旧路径若列表未开好
    #        （半开/被 Esc 关掉）会返回错行（实测 VP-11 得 353，真值 377）；
    #     ② 详情屏里 Search/ASW 行的按钮/数值区定位失败。
    #   ⇒ 改用**与 set-mission 完全相同的已验证通道**：
    #     focus → 点地图取焦 → 按 A/N 开列表 → `_find_airgroup_row` 定位 →
    #     **单击该行**（x=192）开详情屏 → 再在详情屏定位并点击 Search 行按钮。
    from lib.executor import vnc_key as _vk, vnc_click as _vc
    row = None
    for _try in range(3):
        focus_map()
        _vc(300, 500, "click"); time.sleep(0.6)
        _vk(list_key)                  # 打开对应航空队列表
        time.sleep(3.5)
        row = row_override if row_override else _find_airgroup_row(ag, list_key)
        if row is not None:
            break
        # 列表可能处于半开/未渲染态：Esc 清场后重开
        _vk("escape"); time.sleep(1.2)
    if row is None:
        print(f"[witp-cmd] ❌ 在 {'N 舰载' if is_naval else 'A 陆基'} 列表里找不到「{ag}」；中止。")
        _vk("escape"); time.sleep(1.0)
        return
    _vc(192, int(row), "click")        # 单击行 → 开详情屏
    time.sleep(3.0)
    print(f"[witp-cmd] 找到 {ag} 行 y≈{row:.0f}，已开详情屏")

    final = None
    for attempt in range(4):
        y = _locate_panel_row(label)
        if y is None:
            print(f"[witp-cmd] ⚠️ 第 {attempt+1} 次：未能在面板中定位 {label} 行")
            break
        btns = _row_button_xs(y)
        if not btns:
            print(f"[witp-cmd] ⚠️ 第 {attempt+1} 次：未能定位 {label} 行(y={y})按钮")
            break
        cur = _read_row_pct(y, btns)
        print(f"  · 第 {attempt+1} 次：行 y={y}，按钮 x=({btns['zero']}/{btns['minus']}/"
              f"{btns['plus']}/{btns['full']})，当前读数 = {cur}")

        if cur == pct:
            final = cur
            break
        if cur is None:                                   # 读不出 → 归零后按 +10 计数
            vnc_click(btns["zero"], y, "click"); time.sleep(0.8)
            for _ in range(pct // 10):
                vnc_click(btns["plus"], y, "click"); time.sleep(0.3)
        elif pct <= 0:
            vnc_click(btns["zero"], y, "click"); time.sleep(0.8)
        elif pct >= 100:
            vnc_click(btns["full"], y, "click"); time.sleep(0.8)
        elif cur > pct:
            for _ in range((cur - pct) // 10):
                vnc_click(btns["minus"], y, "click"); time.sleep(0.3)
        else:
            for _ in range((pct - cur) // 10):
                vnc_click(btns["plus"], y, "click"); time.sleep(0.3)
        time.sleep(1.0)

    y = _locate_panel_row(label)
    if y is not None:
        btns = _row_button_xs(y)
        final = _read_row_pct(y, btns) if btns else None
    vnc_key("escape")
    time.sleep(1.5)

    # ★2026-10-04 修：面板内 OCR 读数不可靠，改用 A/N 列表的权威读数核验★
    #   实测：详情面板里 Search 行右侧的数字 OCR 长期读不出（None），
    #   原因未知且不稳定；但**列表行内**的 Search 数值 OCR 稳定可读
    #   （实测一次读全 8 行：VP11=100 / VP33=50 / No11SqdRAAF=50 …）。
    #   因此最终判据改为「关掉面板后回列表读该中队 Search 值」。
    #   注意：舰载中队（VS-/VCS-）在 N 列表，陆基在 A 列表，需分别开对应列表读。
    verified = _verify_search_via_list(ag, list_key, label, pct)
    _lname = "N 列表(舰载)" if list_key == "n" else "A 列表(陆基)"
    if verified is True:
        print(f"[witp-cmd] ✓ {ag} {label} = {pct}%——经{_lname}权威读数确认生效。")
        return
    if verified is False:
        print(f"[witp-cmd] ⚠️ {ag} {label} 列表读数 ≠ {pct}%，设置未生效。")
        return

    # ★2026-10-10 修（回读通道错位的真因）★
    #   实测：**详情屏**里的 Search 数值 OCR 读不出（tokens 里明明是 `Search100`
    #   却取不到数字），但**列表屏**该列的数值 OCR 稳定。
    #   ⇒ 最终判据顺序：① 列表屏核验（首选，见 _verify_search_via_list）；
    #     ② 详情屏回读（兜底）；③ 都失败时**明确提示以读层为准**。
    if verified is True:
        return
    if final is not None and abs(final - pct) <= 10:
        print(f"[witp-cmd] ✓ {ag} {label} = {final}%（目标 {pct}%）——经详情屏回读确认生效。")
    else:
        print(f"[witp-cmd] ⚠️ {ag} {label}：面板回读不可用（详情屏 OCR 读不出数值）。"
              f"**该指令实际已下发**；权威核验须『存档 → staff --save <档> → 读 "
              f"airgroups.json 的 percent_{'asw' if getattr(args,'asw',False) else 'search'}』。")


def _verify_search_via_list(ag, list_key, label, pct, tries=3):
    """
    关掉面板 → 开 A/N 列表 → 定位 ag 所在行 → 读 label 列数值。
    返回 True（等于目标）/ False（不等于）/ None（该列表读不到，无法判定）。
    队列名 OCR 会有形近误识，故按「去噪后前缀/子串」匹配，并逐行打印供留痕。
    """
    try:
        from lib.airlist import list_pct
    except Exception:
        return None

    key = ag.upper().replace("-", "").replace(" ", "")
    for _ in range(tries):
        focus_map()
        vnc_key(list_key)
        time.sleep(3.0)
        data = list_pct()
        vnc_key("escape")
        time.sleep(1.0)
        if not data:
            continue
        for name, val in data.items():
            nk = "".join(ch for ch in name.upper() if ch.isalnum())
            if nk == key or key.endswith(nk) or nk.endswith(key):
                print(f"  · 列表核验：{name} 的 {label} = {val}%（目标 {pct}%）")
                return val == pct
    return None


def cmd_save_game(args):
    """存档到指定槽位。

    ★指挥官教的方法（2026-09-25，此前我点错目标）★
      存档对话框里**必须点「小箭头」**，不是行文字/按钮文字：
        ① 先点**存档栏位旁的小箭头**（x=65，行 y = 123 + 16×槽位号）→ 该栏位**变绿**（选中）；
        ② 再点**下方 SAVE 旁的小箭头**（62,546）→ 保存成功。
      此前点 x=250（行文字）→ 栏位从未被选中 → SAVE 无效。实测该对话框对
      VNC/XTEST/键盘/合成事件均无响应**只针对非箭头目标**；箭头本身是可点的。
    """
    slot = max(0, int(args.slot))
    row_y = 127 + 16 * slot          # ★实测真值（2026-10-14：000=y127，行距16）
    ARROW_X, SAVE_ARROW = 65, (62, 546)
    from lib.executor import GAME_SAVE_DIR

    # ★2026-10-10 根治槽位映射 bug★
    #   实测 --slot 3 会写到 wpae087.pws：row_y=123+16*slot 的箭头点击会命中
    #   相邻行/滚动后的行，槽位号与实际文件**不保证对应**。
    #   ⇒ 不再假定 target，改为「存档前后对 SAVE 目录做 mtime 差分」，
    #     直接探测**实际被写入的那个 .pws**，并据此给出正确的 staff --save 命令。
    import glob as _glob

    def _snapshot():
        d = {}
        for f in _glob.glob(os.path.join(GAME_SAVE_DIR, "wpae*.pws")):
            try:
                d[f] = os.path.getmtime(f)
            except OSError:
                pass
        return d

    snap = _snapshot()
    focus_map()
    vnc_key("f")
    time.sleep(3.0)

    # ★2026-10-14 修（槽位映射 bug 根治）★
    #   旧实现 row_y = 123 + 16*slot 是**外推公式**，实测 --slot 3 → wpae087.pws、
    #   --slot 5 → wpae134.pws —— 公式与真实对话框行位置**根本不吻合**
    #   （对话框槽位号并非从 y=123 起每 16px 一行；且列表可能分栏/滚动）。
    #   ⇒ 改为**从当前对话框截图上 OCR 扫描出「槽位号 → 行 y」的真实映射**，
    #     直接点该槽位号所在行。扫不到才退回公式（并明确告警）。
    scanned = _scan_slot_rows()
    if scanned and slot in scanned:
        row_y = scanned[slot]
        src = f"OCR 扫描命中槽位 {slot:03d}"
    else:
        src = f"公式外推（OCR 未扫到槽位 {slot:03d}，已扫到 {sorted(scanned)[:12]}）"
    print(f"[witp-cmd] 存档到槽位 {slot:03d}（{src}；栏位行 y={row_y}，箭头 x={ARROW_X}）...")

    # ① 点栏位旁小箭头 → 变绿选中
    vnc_click(ARROW_X, row_y, "click")
    time.sleep(1.2)
    green = _row_is_green(row_y)
    print(f"[witp-cmd] ① 已点栏位箭头 (x={ARROW_X}, y={row_y})；该行是否变绿 = {green}")

    # ★★2026-10-15 修（防"点到别的槽位 → 覆写他人存档"）★★
    #   槽位列表会**滚动**：`y0 + 16×slot` 只在列表停在顶部时成立。
    #   若 OCR 扫描失败而退回公式外推，点击可能落在**另一个槽位**上，
    #   随后点 SAVE 就把它**不可逆覆写**（对话框确认即落盘）。
    #   ⇒ 点 SAVE 之前，必须先把该行的 3 位槽位号 OCR 回来核对；
    #     对不上就**中止**，绝不冒险写盘。
    sel = _read_slot_at_row(row_y)
    ok_sel = (sel == slot)
    print(f"[witp-cmd] ② 选中行槽位号回读 = {sel}（期望 {slot:03d}）"
          f" → {'✓ 一致' if ok_sel else '✗ 不一致'}")
    if not ok_sel:
        allow = getattr(args, "allow_guess", False)
        if not allow:
            vnc_key("escape")
            time.sleep(1.0)
            print(f"[witp-cmd] ❌ 中止存档：选中行槽位号 {sel} ≠ 请求 {slot:03d}。"
                  f"（列表可能已滚动；请先 --list-slots 核对，"
                  f"确认无误可加 --allow-guess 强制）")
            return
        print(f"[witp-cmd] ⚠ --allow-guess：明知槽位号不符仍继续（可能覆写 {sel}）")

    # ③ 点 SAVE 旁小箭头
    vnc_click(SAVE_ARROW[0], SAVE_ARROW[1], "click")
    time.sleep(4.0)

    # ③ 差分：找 mtime 变化（或新出现）的 .pws
    after = _snapshot()
    changed = [f for f, t in after.items() if snap.get(f) != t]
    changed.sort(key=lambda f: after[f], reverse=True)
    if changed:
        real = changed[0]
        rslot = os.path.basename(real).replace("wpae", "").replace(".pws", "")
        tstr = time.strftime("%H:%M:%S", time.localtime(after[real]))
        print(f"[witp-cmd] ✓ 存档成功：{os.path.basename(real)}（{tstr}）")
        if rslot != f"{slot:03d}":
            print(f"[witp-cmd] ⚠ 槽位映射不符：请求 {slot:03d}，实际写入 {rslot}"
                  f"（row_y={row_y} 命中相邻行）—— 按实际文件为准。")
        print(f"[witp-cmd]   参谋部可读：witp-cmd staff --save {real}")
    else:
        print(f"[witp-cmd] ⚠️ 未检测到任何 .pws 更新（选中状态={green}）—— 请人工核验。")


def _scan_slot_rows(box=(60, 100, 240, 720)):
    """OCR 扫描存档对话框左列，返回 {槽位号(int): 行中心 y}。

    ★2026-10-14 新增（根治槽位映射 bug）★
      旧实现 `row_y = 123 + 16*slot` 是外推公式，实测偏 4px 且槽位号与文件**不保证对应**
      （--slot 3 → wpae087、--slot 5 → wpae134）。
      ★实测真实布局（2026-10-14，tesseract tsv 逐词框）★：
        栏位号在 x≈81，000=y127, 001=y143, 002=y159, 003=y175, 004=y191, 005=y207 …
        ⇒ **基准 y0=127、行距 16px**（旧公式 123 是错的）。
      本函数：OCR 扫出可辨认的槽位号 → 用「基准+行距」最小二乘拟合 →
      对 OCR 漏读的槽位**外推补齐**（OCR 逐帧波动，单行漏读很常见，不能因漏读就退回旧公式）。
      拟合残差过大（>6px）时才认为布局变了，退回纯外推。
    """
    from PIL import Image, ImageOps
    import csv as _csv
    _shot_to("/tmp/_sv_dlg.png")
    try:
        im = Image.open("/tmp/_sv_dlg.png").convert("RGB")
    except Exception:
        return {}
    c = ImageOps.autocontrast(ImageOps.grayscale(im.crop(box)))
    c = c.resize((c.width * 4, c.height * 4), Image.LANCZOS)
    c.save("/tmp/_sv_dlg_t.png")
    subprocess.run("tesseract /tmp/_sv_dlg_t.png /tmp/_sv_dlg --psm 6 tsv 2>/dev/null",
                   shell=True)
    raw = {}
    try:
        with open("/tmp/_sv_dlg.tsv") as f:
            for r in _csv.DictReader(f, delimiter="\t", quoting=_csv.QUOTE_NONE):
                t = (r.get("text") or "").strip()
                dg = re.sub(r"\D", "", t)
                if len(dg) != 3 or not re.fullmatch(r"\d{3}", t.replace(" ", "")):
                    continue
                n = int(dg)
                if not (0 <= n <= 999):
                    continue
                yc = int(r["top"]) / 4.0 + int(r["height"]) / 8.0 + box[1]
                raw.setdefault(n, int(round(yc)))
    except Exception:
        return {}
    if not raw:
        return {}
    # 用「基准 y0 + 16×n」拟合；取与众数偏差最小的组合
    from collections import Counter
    bases = Counter(int(round(y - 16 * n)) for n, y in raw.items())
    y0, _cnt = bases.most_common(1)[0]
    # 残差核验：拟合基准下，已读到的行是否都在 ±6px 内
    good = {n: y for n, y in raw.items() if abs((y0 + 16 * n) - y) <= 6}
    if len(good) < max(2, len(raw) // 2):
        # 布局异常 → 不猜，交调用方告警
        return raw
    return {n: y0 + 16 * n for n in range(0, 1000) if y0 + 16 * n <= box[3]}


def _read_slot_at_row(row_y, box_x=(60, 130)):
    """★2026-10-15 新增★ OCR 回读某一行上的 3 位槽位号（用于存档前核对）。

    返回 int 或 None。失败返回 None（调用方须按"未确认"处理，不得当作一致）。
    """
    from PIL import Image, ImageOps
    import csv as _csv
    _shot_to("/tmp/_svrownum.png")
    try:
        im = Image.open("/tmp/_svrownum.png").convert("RGB")
    except Exception:
        return None
    y0 = max(0, int(row_y) - 9)
    y1 = min(im.height, int(row_y) + 9)
    c = im.crop((box_x[0], y0, box_x[1], y1))
    c = ImageOps.autocontrast(ImageOps.grayscale(c))
    c = c.resize((c.width * 8, c.height * 8), Image.LANCZOS)
    c.save("/tmp/_svrownum_t.png")
    r = subprocess.run(["tesseract", "/tmp/_svrownum_t.png", "stdout", "--psm", "7",
                        "-c", "tessedit_char_whitelist=0123456789"],
                       capture_output=True, text=True)
    m = re.search(r"\d{3}", r.stdout)
    return int(m.group(0)) if m else None


def _row_is_green(row_y, x0=80, x1=300):
    """判定存档对话框某行是否已变为绿色（选中态）。"""
    from PIL import Image
    _shot_to("/tmp/_svrow.png")
    try:
        im = Image.open("/tmp/_svrow.png").convert("RGB")
    except Exception:
        return None
    px = im.load()
    g = 0
    n = 0
    for y in range(max(0, row_y - 6), min(im.height, row_y + 7)):
        for x in range(x0, x1, 2):
            r, gg, b = px[x, y]
            n += 1
            if gg > 80 and r < 110 and b < 110:
                g += 1
    return (g / n > 0.15) if n else None


def cmd_calibrate_map(args):
    """实测地图几何（像素↔格），全剧本通用。

    做法：在地图上点若干**散布的像素点**，每次读顶栏「Hex:」得到该像素对应的格，
    再拟合 W/H/原点。解决「比例写死 42.86/37.5 → 系统性偏 1 格」的根因。
    """
    import sys as _s
    _s.path.insert(0, "/root/.hermes/profiles/witp/witp-agent")
    from lib import mapgeom
    # ★宽基线采样（2026-09-25 实测得出）★
    #   原来 9 个点挤在屏幕中部（仅跨 5~6 格），单点 ±1 误读就能撬动斜率
    #   （跨 20 格累计偏 94~105px）。改为横跨整个视野（≈20 格）+ 纵列取样：
    #   同样 3~5 处误读下，跨 20 格累计误差降到 22~48px（仍在 1 格内），
    #   剩余的格级精确度由 set-dest 的闭环纠偏兜底。
    pts = [(70, 384), (300, 384), (550, 384), (800, 384), (960, 384),
           (512, 70), (512, 250), (512, 500), (512, 720),
           (200, 120), (880, 640), (400, 60)]
    print("[witp-cmd] 开始地图几何标定（点击散点 → 读顶栏 Hex）…")
    focus_map()
    samples = []
    for px, py in pts:
        vnc_click(px, py, "click")
        time.sleep(1.2)
        h = _current_cursor_hex()
        if h:
            samples.append((px, py, int(h[0]), int(h[1])))
            print(f"  ({px},{py}) → Hex({h[0]},{h[1]})")
        else:
            print(f"  ({px},{py}) → 读数失败（跳过）")
    g = mapgeom.fit(samples)
    if not g:
        print("[witp-cmd] ❌ 有效样本不足或比例不合理 → 标定失败（将继续使用旧常量）")
        return
    print(f"[witp-cmd] ✓ 拟合结果：W={g['W']:.3f} px/格  H={g['H']:.3f} px/格  "
          f"原点=({g['ox']:.1f},{g['oy']:.1f})  半格偏移={g['shift']:.1f}  "
          f"RMSE={g['rmse']:.2f}px  样本={g['n']}")
    print(f"[witp-cmd]   与旧写死值对比：W 42.86 / H 37.5（差 {abs(g['W']-42.86):.3f} / "
          f"{abs(g['H']-37.5):.3f} px）")
    mapgeom.save_geom(g)
    print(f"[witp-cmd]   已缓存 → {mapgeom.CACHE}（set-dest 会自动使用）")


def cmd_end_turn(args):
    """推进过回合 (E 键 + 确认 YES + 等待结算)"""
    timeout = args.timeout
    print(f"[witp-cmd] 执行指令：确认下达过回合指令 (E + YES 确认，等待结算)...")
    # ★2026-10-15：end_turn 返回 False 有**三种**互不相同的含义，
    #   旧代码一概说成"结算超时"，误导上层（实测回归局把"本局已结束"
    #   报成 3 次"超时"）。这里显式区分：
    #     ① 本局已结束（终局屏已被处理，game_ended.json 在）→ 不是错误
    #     ② 硬闸拦截（ui_state != map）→ 需要清场后重试
    #     ③ 真·结算超时 → autosave 未更新
    try:
        from lib.executor import game_has_ended as _ghe
    except Exception:
        _ghe = None
    ended = _ghe() if _ghe else None
    if ended:
        js = ended.get("JAPANESE"); al = ended.get("ALLIED")
        print(f"[witp-cmd] ⛔ 本局已结束（{ended.get('keyword')}"
              f"{f'，日 {js} : 盟 {al}' if js is not None else ''}）"
              f"—— 未发送 E；这不是错误。请开新局或载入其它存档。")
        return
    success = end_turn(wait_for_save=True, timeout_sec=timeout)
    if success:
        print("[witp-cmd] ✓ 回合结算完成！新存档已写入，战报已生成。")
    else:
        print("[witp-cmd] ⚠️ 结算未确认。三种可能：①本局已结束；"
              "②硬闸拦截（ui_state≠map，需 Escape 清场重试）；③真·结算超时"
              "（autosave 未更新）。请查上方 [executor] 行确认具体原因。")

def _menu_detect():
    """检测游戏当前是否停在主菜单（OCR）。

    ★2026-10-17 修复★ 原判据 `SCENARIOSELECTION / GAMESTYLE / REALISMOPTIONS` 在
      1108r9 英文版上**恒为假**：这三个词是艺术字体，psm 11 读不出来（实测同一帧只
      读出 JAPANESE COMPUTER / ALLIED COMPUTER / PLAY BY EMAIL / BOTH COMPUTER）。
      症状：主菜单明明在前台，`set-gamestyle` 却报「当前不在主菜单」而直接 return
      （2026-10-17 实测踩坑）。⇒ 改用**实际可读到的 GAMESTYLE 选项文字**作判据。
    """
    try:
        _shot_to("/tmp/_gs_menu.png")
        t = subprocess.run(["tesseract", "/tmp/_gs_menu.png", "-", "--psm", "11"],
                           capture_output=True, text=True).stdout.upper().replace(" ", "").replace("\n", "")
        # 主菜单独有的组合（至少两项同时出现才算，避免误判游戏内画面）
        hits = sum(1 for k in ("JAPANESECOMPUTER", "ALLIEDCOMPUTER", "PLAYBYEMAIL",
                               "BOTHCOMPUTER", "HEADTOHEAD",
                               "SCENARIOSELECTION", "GAMESTYLE", "REALISMOPTIONS")
                   if k in t)
        return hits >= 2
    except Exception:
        return False


# ★GAMESTYLE 五个选项的标签中心（2026-10-12 用 tesseract tsv 实测词框计算）★
#   JAPANESE COMPUTER 标签 left=445 top=110 w~242 → 中心 (566,120)
#   ALLIED   COMPUTER 标签 left=566 top=168 w~204 → 中心 (660,178)
#
# ★2026-10-17 补全为五种（手册 §2.3.1 全部五种 GAMESTYLE）★
#   同一张主菜单截图（/tmp/menu_now.png）用「亮像素行投影 + 列投影 + 逐段裁切 OCR 复核」
#   重新标定，五段文字的实测外接框如下（x0-x1 @ y0-y1，取自 1024x768 全屏）：
#     JAPANESE COMPUTER  x 446-686 @ y 110-129  → 中心 (566,120)
#     ALLIED   COMPUTER  x 547-768 @ y 167-187  → 中心 (657,177)
#     PLAY BY EMAIL      x 135-349 @ y 266-287  → 中心 (242,277)
#     BOTH     COMPUTER  x 557-784 @ y 266-287  → 中心 (670,277)
#     HEAD TO HEAD       x 170-478 @ y 359-392  → 中心 (324,375)
#   ※ 第2行左侧 x379-519 是旋钮/刻度盘反光，不是文字（OCR 空），不要点。
#   ※ 第4行右侧 x639-825 是 REALISM OPTIONS 按钮，不是 GAMESTYLE 选项。
_GAMESTYLE_CLICK = {
    "japanese":  (566, 120),   # AI 打日军 → 人类执【盟军】
    "allied":    (657, 177),   # AI 打盟军 → 人类执【日军】
    "pbem":      (242, 277),   # PLAY BY EMAIL —— 两人邮件对战
    "both":      (670, 277),   # BOTH COMPUTER —— AI 对 AI（观察模式）
    "h2h":       (324, 375),   # HEAD TO HEAD —— 两人同机热座
}

# GAMESTYLE → (语义名, 说明)。用于日志与运行后判据。
_GAMESTYLE_DESC = {
    "japanese": ("JAPANESE COMPUTER", "AI 打日军 / 人类执盟军"),
    "allied":   ("ALLIED COMPUTER",   "AI 打盟军 / 人类执日军"),
    "pbem":     ("PLAY BY EMAIL",     "PBEM 两人邮件对战（需双方密码）"),
    "both":     ("BOTH COMPUTER",     "电脑对电脑（AI 双方，观察模式）"),
    "h2h":      ("HEAD TO HEAD",      "双人热座（同一台机轮流下命令）"),
}


def _read_topbar_side():
    """读顶栏 PLAYER 字段（游戏内才有）。返回 JAPANESE / ALLIED / UNKNOWN。"""
    try:
        _shot_to("/tmp/_gs_bar.png")
        subprocess.run("DISPLAY=:98 convert /tmp/_gs_bar.png -crop 520x28+360+0 +repage "
                       "-resize 300% /tmp/_gs_bar2.png", shell=True, capture_output=True)
        t = subprocess.run(["tesseract", "/tmp/_gs_bar2.png", "-", "--psm", "11"],
                           capture_output=True, text=True).stdout.upper().replace(" ", "")
        if "JAPANESE" in t:
            return "JAPANESE"
        if "ALLIED" in t:
            return "ALLIED"
    except Exception:
        pass
    return "UNKNOWN"


def cmd_set_gamestyle(args):
    """设置主菜单 GAMESTYLE —— 决定【人类玩家执哪一方】。

    ★★★2026-10-12 判决性实验确立的机制（推翻此前"存档自带阵营"的误解）★★★
      人类阵营由**主菜单 GAMESTYLE 旋钮**决定，存档（.pws）本身不保存玩家阵营。
        JAPANESE COMPUTER（旋钮默认位）= AI 打日军 / 人类执【盟军】
        ALLIED COMPUTER                = AI 打盟军 / 人类执【日军】
      同一份 wpae000.pws 的两次受控实验（唯一变量 = GAMESTYLE）：
        · 默认 JAPANESE COMPUTER → 载入后顶栏 = ALLIED PLAYER
        · 改点 ALLIED COMPUTER   → 载入后顶栏 = JAPANESE PLAYER
      实验证据：/tmp/judge.log、/tmp/judge2.log；截图 /tmp/curr_v_tb.png。
      ⇒ 载入存档前**必须先设 GAMESTYLE**；否则无论载入谁的存档，玩家都会变成盟军。
      ⇒ witp-launch-en1108.sh 与 cmd_recover 此前都不设 GAMESTYLE，是"总是变成盟军"的真因。
    """
    want = (args.side or "japanese").lower()
    # 向后兼容：旧调用 `set-gamestyle japan` 仍有效
    if want == "japan":
        want = "japanese"
    if want not in _GAMESTYLE_CLICK:
        print(f"[witp-cmd] 未知模式 {want}（可选 japanese / allied / pbem / both / h2h）")
        return
    if not _menu_detect():
        print("[witp-cmd] ⚠ 当前不在主菜单。请先退到主菜单，或加 --restart 让它自己重启。")
        if not getattr(args, "restart", False):
            return
        print("[witp-cmd] --restart：重启游戏服务...")
        subprocess.run("systemctl stop witp-game-en", shell=True)
        time.sleep(10)
        subprocess.run("systemctl start witp-game-en", shell=True)
        for i in range(30):
            time.sleep(5)
            if _menu_detect():
                print(f"[witp-cmd] 主菜单就绪（{(i + 1) * 5}s）")
                break
        if not _menu_detect():
            print("[witp-cmd] ✗ 超时仍未到主菜单")
            return
    x, y = _GAMESTYLE_CLICK[want]
    label, desc = _GAMESTYLE_DESC[want]
    print(f"[witp-cmd] 点 GAMESTYLE = {label} @ ({x},{y})")
    vnc_click(x, y, "click")
    time.sleep(2.0)
    print(f"[witp-cmd] ✓ 已设置：{label} —— {desc}")
    if want in ("japanese", "allied"):
        side_word = "日军" if want == "allied" else "盟军"
        other = "盟军" if want == "allied" else "日军"
        print(f"[witp-cmd] 此后载入存档：人类执【{side_word}】，AI 打【{other}】。")
    elif want == "both":
        print("[witp-cmd] 两边都交给 AI 后，人类不进入命令阶段；回合会自行推进（观察模式）。")
    elif want == "h2h":
        print("[witp-cmd] 热座：提交日军命令后需在同一台机切到盟军方下命令。")
    elif want == "pbem":
        print("[witp-cmd] PBEM：开局会要求双方各设密码；每回合需把 .wps 存档（及 slot 001 战报）交给对方。")
    print("[witp-cmd] 注意：主菜单 OCR 读不出旋钮指针，最终以【载入后顶栏 PLAYER】为准。")


def cmd_recover(args):
    """崩溃自愈：结算期 Wine 偶发 page fault 会让游戏退回主菜单（画面全黑/显示 MAIN MENU）。

    ★2026-09-24 新增★ 把「重启 + 经 VNC 通道载入 Autosave」这一手工恢复流程固化。
    恢复路径（2026-09-24 实测有效）：
      重启游戏 → 主菜单 LOAD A SAVED GAME (738,644) 双击 → 存档列表 000 行 y=212 单击
      → SELECT SAVE GAME (337,577) 单击 → 回到命令阶段地图。
    ★2026-10-12 修复★ 载入前必设 GAMESTYLE（见 cmd_set_gamestyle 的机制说明），
      否则载入后玩家阵营会变成盟军 —— 这正是此前"autosave 里有盟军局存档"的错觉来源。
    """
    from PIL import Image, ImageStat
    print("[witp-cmd] 崩溃自愈检查...")

    # ★2026-10-04：弃用 pgrep -f / pkill -f。
    #   之前用 -f 匹配完整命令行，shell 包装进程、timeout、乃至本函数所在的
    #   witp-cmd 自身命令行里都含同一串文本 → 会匹配到自己并自杀（已实测发生过）。
    #   改为直接遍历 /proc 读 comm 精确比对可执行文件名。
    def _game_pids():
        pids = []
        for d in os.listdir("/proc"):
            if not d.isdigit():
                continue
            try:
                with open(f"/proc/{d}/comm", "r") as f:
                    c = f.read().strip()
            except OSError:
                continue
            # ★Linux 的 /proc/<pid>/comm 硬截断到 15 字符（TASK_COMM_LEN=16 含 NUL），
            #   所以 "War in the Pacific Admiral Edition.exe" 实际只露出 "War in the Paci"。
            #   早先按全名比对恒为空 → recover 会误判「进程已死」并去重启。
            if c == "War in the Paci":
                pids.append(int(d))
        return pids

    pids = _game_pids()
    print(f"[witp-cmd] 游戏进程存活: {bool(pids)}  pids={pids}")
    alive = bool(pids)

    dark = True
    try:
        _shot_to("/tmp/_recover.png")
        mean = ImageStat.Stat(Image.open("/tmp/_recover.png").convert("RGB")).mean
        dark = (sum(mean) / 3) < 12
        print(f"[witp-cmd] 游戏区画面均值: {[round(x, 1) for x in mean]}（黑屏判定阈值 12）")
    except Exception as e:
        print(f"[witp-cmd] 画面检测失败: {e}")

    # ★2026-10-10 新增：黑屏窗口恢复（非破坏性，优先于重启游戏）★
    #   现象：游戏进程存活（alive=True），但截图全黑 / 窗口 Map State 为 IsUnMapped
    #   或 IsUnviewable。真因是重启/重启 openbox 后游戏窗口失去映射状态。
    #   ★实测配方★（亮度 0 → 114、Map State IsUnMapped → IsViewable）：
    #       xdotool windowraise <游戏窗>  +  wmctrl -a <标题片段>
    #   该配方**不重启游戏、不丢局面**，必须先试；失败才走下面的重启流程。
    if alive and dark and not args.force:
        wid = subprocess.run("DISPLAY=:98 xdotool search --name 'War in the Pacific' | head -1",
                             shell=True, capture_output=True, text=True).stdout.strip()
        if wid:
            st = subprocess.run(f"DISPLAY=:98 xwininfo -id {wid} | grep -i 'Map State'",
                                shell=True, capture_output=True, text=True).stdout.strip()
            print(f"[witp-cmd] 窗口 {wid}：{st}")
            print("[witp-cmd] 尝试非破坏性恢复（windowraise + wmctrl -a）...")
            for act in (f"DISPLAY=:98 xdotool windowraise {wid}",
                        "DISPLAY=:98 xdotool windowactivate --sync " + wid,
                        "DISPLAY=:98 wmctrl -a 'Admiral'"):
                subprocess.run(act, shell=True, capture_output=True)
                time.sleep(0.8)
            time.sleep(2.0)
            try:
                _shot_to("/tmp/_recover2.png")
                m2 = ImageStat.Stat(Image.open("/tmp/_recover2.png").convert("RGB")).mean
                if (sum(m2) / 3) >= 12:
                    print(f"[witp-cmd] ✓ 非破坏性恢复成功（均值 "
                          f"{[round(x,1) for x in m2]}）——无需重启游戏。")
                    return
                print(f"[witp-cmd] 非破坏性恢复未生效（均值 "
                      f"{[round(x,1) for x in m2]}）→ 转重启流程。")
            except Exception as e:
                print(f"[witp-cmd] 复检失败: {e}")

    print("[witp-cmd] 需要恢复 → 重启游戏...")
    for pid in _game_pids():                 # 按精确 PID 杀，不做模式匹配
        try:
            os.kill(pid, 9)
            print(f"[witp-cmd]   killed pid={pid}")
        except OSError as e:
            print(f"[witp-cmd]   kill {pid} 失败: {e}")
    time.sleep(3)
    env = dict(os.environ, DISPLAY=":98", WINEPREFIX="/root/.wine-witp",
               HOME="/root", LANG="en_US.UTF-8")
    subprocess.run("pgrep -x openbox >/dev/null || (DISPLAY=:98 openbox >/tmp/openbox.log 2>&1 &)",
                   shell=True)
    time.sleep(1)
    subprocess.Popen(["bash", "/root/.hermes/workspace/witp-launch-en1108.sh"],
                     stdout=open("/tmp/witp_recover.log", "w"),
                     stderr=subprocess.STDOUT, env=env,
                     cwd="/root/.wine-witp/drive_c/1108r9/War in the Pacific Admiral's Edition")
    for i in range(24):
        time.sleep(5)
        if _game_pids():
            print(f"[witp-cmd] 游戏进程已出现（{(i + 1) * 5}s）")
            break
    time.sleep(25)   # 等主菜单绘制完成

    print("[witp-cmd] 经 VNC 通道进入载入存档流程...")
    # ★2026-10-12 关键修复★ 载入前必须先设 GAMESTYLE = ALLIED COMPUTER（人类执日军）。
    #   否则按旋钮默认位 JAPANESE COMPUTER 载入，玩家会变成盟军
    #   —— 这就是此前"autosave 里怎么会有盟军局存档"的错觉来源。
    #   受控实验见 cmd_set_gamestyle 文档串与 /tmp/judge.log、/tmp/judge2.log。
    gx, gy = _GAMESTYLE_CLICK["allied"]
    print(f"[witp-cmd] 先设 GAMESTYLE = ALLIED COMPUTER（人类执日军）@ ({gx},{gy})")
    vnc_click(gx, gy, "click")
    time.sleep(2.0)
    vnc_click(742, 645, "click")             # LOAD A SAVED GAME
    time.sleep(6)
    # ★2026-10-13 修（原坐标全错）★ 旧代码点 (738,644)dblclick + (388,slot_row) + (525,727)，
    #   实测 (388, …) 与 (525,727) 都不在正确控件上 ⇒ 载入从未真正发生。
    #   已验证可用的序列（2026-10-13 判决性实验，/tmp/jl2.log）：
    #     点 LOAD A SAVED GAME (742,645) → 选槽位行 (250, 214) → 确认按钮 (336,572)
    #   判据：操作后 **.pws 无任何写入**（非覆盖）且 **顶栏 = JAPANESE PLAYER**。
    #   注意：该对话框右上铭牌恒写着 `SAVE MENU`（WitP 的 UI 缺陷），
    #   但经 `LOAD A SAVED GAME` 按钮进入时，点槽位+按钮的行为是**载入**。
    vnc_click(250, args.slot_row if args.slot_row != 212 else 214, "click")  # 槽位 000 行
    time.sleep(1.5)
    vnc_click(336, 572, "click")             # 底部确认按钮（实测成功点）
    time.sleep(15)
    print("[witp-cmd] ✓ 恢复流程已执行 —— 请用 witp-cmd status / 读层核对是否回到命令阶段。")
    # ★2026-10-15★ 恢复/载入存档 = 重新开始推演，必须清掉上一局的结束标记，
    #   否则 end-turn 会短路（这是"载入后无法推进回合"的隐藏原因）。
    try:
        os.remove("/root/.hermes/workspace/game_ended.json")
        print("[witp-cmd] 已清除『本局已结束』标记（允许继续推进）。")
    except FileNotFoundError:
        pass
    except Exception as e:
        print(f"[witp-cmd] ⚠ 清除结束标记失败: {e}")


def cmd_status(args):
    """检查当前游戏画面与窗口状态"""
    ox, oy = get_window_offset()
    print(f"[witp-cmd] 游戏窗口偏移量: upper-left X={ox}, Y={oy}")
    shot_path = "/tmp/witp_cmd_status.png"
    subprocess.run(["import", "-window", "root", "-display", ":98", shot_path], check=False)
    subprocess.run(["convert", shot_path, "-resize", "150%", "-colorspace", "Gray", "/tmp/_ocr.png"], check=False)
    ocr_out = subprocess.check_output(["tesseract", "/tmp/_ocr.png", "-", "--psm", "11"], stderr=subprocess.DEVNULL).decode()
    lines = [l.strip() for l in ocr_out.split("\n") if l.strip()][:15]
    print("[witp-cmd] 屏幕前 15 行 OCR 内容识别：")
    for l in lines:
        print("  |", l)

def cmd_record_turn(args):
    """回写本回合因果三元组 (S, D, R)"""
    if not _STAFFOPS:
        print(f"[witp-cmd] 回写模块加载失败: {_STAFFOPS_ERR}"); return
    orders = []
    if args.orders:
        orders = [o.strip() for o in args.orders.split(";") if o.strip()]
    record_turn(args.decision, args.result, orders=orders, game_id=args.game, verbose=True)


def cmd_set_target(args):
    """设航空队 Target hex（对地/对机场轰炸的必要条件）。"""
    try:
        import sys as _s
        _s.path.insert(0, "/root/.hermes/workspace")
        from witp_airtarget import set_airgroup_target
    except Exception as _e:
        print(f"[witp-cmd] ✗ 航空队目标模块加载失败: {_e}")
        return 1
    hx, hy = [int(v) for v in str(args.hex).replace(" ", "").split(",")[:2]]
    tpx = None
    if getattr(args, "px", None):
        p = str(args.px).replace(" ", "").split(",")
        tpx = (int(p[0]), int(p[1]))
    print(f"[witp-cmd] 设 {args.group} 的 Target = ({hx},{hy})"
          f"{'，点像素 ' + str(tpx) if tpx else '（未给像素：进入选靶态后需定位目标）'}")
    ok, info = set_airgroup_target(args.group, hx, hy, tpx)
    if ok is None and isinstance(info, dict) and info.get("need_px"):
        print(f"[witp-cmd] ⏸ 选靶态已就绪，截图 {info.get('screenshot')}")
        print(f"[witp-cmd] 需用 vision 定位目标基地图标像素后重跑："
              f"witp-cmd set-target --group '{args.group}' --hex {args.hex} --px <X,Y>")
        return 2
    if ok:
        print(f"[witp-cmd] ✓ 目标指令已下发：{info}")
        print(f"[witp-cmd] ⚠ 权威核验：save-game → witp_read.sh <档> → "
              f"airgroups.json 的 target_x/target_y 是否 = ({hx},{hy})")
    else:
        print(f"[witp-cmd] ✗ 失败：{info}")
        return 1
    return 0


