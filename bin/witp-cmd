        skb_add_doctrine(args.add, confidence=args.confidence, evidence=args.evidence,
                         verbose=True, scope=getattr(args, "scope", "strategy"))
    else:
        skb_status(verbose=True)


def cmd_strike_audit(args):
    """舰载机出击能力审计（对照手册第07章出击成立条件逐条核）。"""
    state = args.state or "/root/.hermes/workspace/witp-reader/state"
    ships_p = os.path.join(state, "ships.json")
    ags_p = os.path.join(state, "airgroups.json")
    if not (os.path.exists(ships_p) and os.path.exists(ags_p)):
        print(f"[witp-cmd] ✗ 读层数据缺失：{ships_p} / {ags_p}")
        return 1
    ships = json.load(open(ships_p, encoding="utf-8"))
    ships = ships if isinstance(ships, list) else ships.get("ships", [])
    ags = json.load(open(ags_p, encoding="utf-8"))
    ags = ags if isinstance(ags, list) else ags.get("airgroups", ags.get("groups", []))

    MISSION = {0: "未设", 1: "对机场", 2: "对港口", 3: "对海攻击", 4: "对地",
               5: "侦察", 6: "护航/CAP", 7: "对海搜索", 8: "反潜", 9: "对城市"}
    PCT_KEYS = ("percent_cap", "percent_lrcap", "percent_asw",
                "percent_search", "percent_train", "percent_rest")

    # ★2026-09-29 修复（换阵营暴露）★ 原判据写死 `nation == "USNAVY"`，
    #   日军侧（IJNAVY）永远匹配不到 → 审计直接报"没有我方航母"。
    #   改为**按舰种枚举我方航母**，不绑国籍；若读层混入敌舰，
    #   用「与已知我方国籍集合一致」兜底过滤。
    cvs_all = [s for s in ships
               if str(s.get("ship_class_type_name")) in ("CV", "CVL", "CVE")]
    # 取读层里出现次数最多的国籍作为「我方」（读层只导出玩家一侧的编队明细，
    #  但 ships.json 有时含少量敌舰）——不写死任何阵营字面量。
    _nat = {}
    for _s in ships:
        _n = str(_s.get("nation") or "")
        if _n:
            _nat[_n] = _nat.get(_n, 0) + 1
    own_nat = {max(_nat, key=_nat.get)} if _nat else set()
    cvs = [s for s in cvs_all if not own_nat or str(s.get("nation")) in own_nat]
    if not cvs:
        print(f"[witp-cmd] 读层里没有我方航母（舰种 CV/CVL/CVE 计数 {len(cvs_all)}，"
              f"国籍分布 {_nat}）")
        return 1


    print("=" * 78)
    print("  舰载机出击能力审计（对照手册 7.2.1.10.1 / 7.2.1.12 / 7.2.1.7.1）")
    print("=" * 78)
    total_strike = 0
    problems = []
    for cv in cvs:
        name = cv.get("name")
        print(f"\n  【{name}】({cv.get('x')},{cv.get('y')})  TF{cv.get('task_force_id')}  "
              f"载机量{cv.get('aircraft_capacity')}  系统损伤{cv.get('system_damage')}")
        groups = [g for g in ags if g.get("stationed_on_ship_name") == name]
        if not groups:
            print("    （读层里找不到该舰的航空队）")
            continue
        strike_ready = 0
        for g in groups:
            mc = g.get("primary_mission_code")
            used = sum(int(g.get(k) or 0) for k in PCT_KEYS)
            free = max(0, 100 - used)
            ready = int(g.get("aircraft_active") or 0)
            mx = int(g.get("aircraft_max") or 0)
            atype = str(g.get("aircraft_type_name") or "")
            is_strike = atype in ("DB", "TBF", "TB", "FB")
            contrib = round(ready * free / 100.0) if is_strike else 0
            strike_ready += contrib
            flag = ""
            if ready == 0:
                flag = "  ⚠ 无可用机"
                problems.append(f"{name}/{g.get('name')}：可用机 0")
            elif is_strike and free == 0:
                flag = "  ⚠ 搜索占满，对海攻击余量 0"
                problems.append(f"{name}/{g.get('name')}：搜索占比占满，无对海攻击余量")
            elif is_strike and mc != 3:
                flag = "  ⚠ 任务不是对海攻击"
                problems.append(f"{name}/{g.get('name')}：任务码 {mc} 不是对海攻击")
            print(f"    {str(g.get('name')):<8}{str(g.get('aircraft_name')):<18}"
                  f"任务={str(MISSION.get(mc, mc)):<9}搜索={str(g.get('percent_search')):>4}% "
                  f"CAP={str(g.get('percent_cap')):>4}%  可用={ready:>3}/{mx:<3}"
                  f"可出击≈{contrib:<4}{flag}")
        total_strike += strike_ready
        print(f"    → 该舰当回合可投入对海攻击的飞机 ≈ {strike_ready} 架")

    print("\n" + "-" * 78)
    print(f"  合计可投入对海攻击 ≈ {total_strike} 架")
    print("  读层无法核验、必须进游戏看的硬阻断项：")
    print("    ① 出击架次 Max Sorties —— 归零则该舰完全不能执行进攻任务（手册 7.2.1.10.1）")
    print("    ② 航母所在格 / 目标格天气 —— 恶劣天气在起飞前中止进攻任务（手册 7.2.1.12）")
    if problems:
        print("\n  ⚠ 发现的问题：")
        for p in problems:
            print(f"    - {p}")
    else:
        print("\n  ✓ 读层可见项均正常（任务=对海攻击、有可用机、搜索未占满）")
    return 0


def cmd_set_tf_mission(args):
    """改 TF 任务（Mission）—— 补齐命令面核心缺口（社区配方必需）。

    ★2026-10-13 实机标定并接入★ 通道与判据详见 `witp_tf_mission.py` 模块文档串。
    要点：
      · Mission 行左侧**圆底箭头图标** @(704,198) → 弹 `Set TF Information` 对话框；
      · 左列任务行中心 y = 252(Surface) / 270(Bombardment) / 287(Fast Transport) /
        306(Transport) / 324(Cargo)；可靠点击 x=200；选中态 = 该行变**绿色高亮**；
      · Done @(256,519)；
      · ★UI 回读只作过程证据，最终必须走「存档 → 读层 taskforces.json 的 mission」核验★。
    动机：游戏会把水面编队的 BOMBARDMENT **自动改回 SURFACE**，
    而社区陆战教条（SKB #88）要求用**舰炮击压制守军**才可能攻占莫港 ——
    此前工具没有改 TF 任务的命令，导致该配方无法执行。
    """
    sys.path.insert(0, "/root/.hermes/workspace")
    try:
        from witp_tf_mission import set_tf_mission, TF_LIST_ROW
    except Exception as e:
        print(f"[witp-cmd] 模块加载失败: {e}")
        return 1
    row = args.row if args.row is not None else TF_LIST_ROW.get(args.tf, 317)
    # ★2026-10-15★ 传 TF 编号给底层：它会 OCR 按编号定位真实行 y
    #   （行位在同局内会漂移；写死行号曾点到 TF7 而非 TF6）。
    import re as _re
    _m = _re.search(r"(\d+)", str(args.tf))
    tf_num = int(_m.group(1)) if _m else None
    print(f"[witp-cmd] 改 {args.tf} 任务 → {args.mission}（回退行 y={row}）")
    ok = set_tf_mission(row, args.mission, tf_num=tf_num)
    print("[witp-cmd] ⚠ 权威核验：save-game → witp-reader/witp_read.sh <档> → taskforces.json 的 mission")
    return 0 if ok else 1


def cmd_set_mission(args):
    """设置航空队任务（任务可自由指派，不必跟中队名走）。

    界面路径：按 N 开舰载航空队列表 → 点该中队行开详情屏 → 点任务列表左侧箭头。
    任务箭头坐标（实测）：x=653，y 按任务：
      Airfield Attack 144 / Port Attack 155 / Naval Attack 167 / Ground Attack 179 /
      Recon 191 / Naval Search 203 / ASW Patrol 215 / Supply Transport 226 /
      City Attack 239 / Training 251 / Stand Down 263
    （任务文本行 y = 箭头 y + 5，实测首行 148、行距 12px，与上表一致）
    """
    MISSION_Y = {
        "airfield": 144, "airfield attack": 144,
        "port": 155, "port attack": 155,
        "naval attack": 167, "naval": 167,
        "ground": 179, "ground attack": 179,
        "recon": 191,
        "naval search": 203, "search": 203,
        "asw": 215, "asw patrol": 215,
        "supply": 226, "supply transport": 226,
        "city": 239, "city attack": 239,
        "training": 251,
        "rest": 263, "stand down": 263,
    }
    key = args.mission.strip().lower()
    y = MISSION_Y.get(key)
    if y is None:
        print(f"[witp-cmd] ✗ 未知任务「{args.mission}」；可用：{' / '.join(sorted(set(MISSION_Y)))}")
        return 1

    from lib.executor import vnc_key, vnc_click
    # ★2026-10-01 修（换阵营暴露的「写死单侧」缺陷）★
    #   原实现**无条件按 N 开舰载航空队列表** —— 但日军/盟军都有大量**陆基**中队
    #   （如日军 `Genzan Ku K-1` 在拉包尔），它们只在 A 列表里 ⇒ 永远找不到。
    #   改为**读层权威判据**：凡出现在我方航母 airgroups 名单里的即舰载（N），否则陆基（A）。
    #   与阵营命名无关，零硬编码。
    try:
        from witp_ground_orders import _is_carrier_group as _icg  # noqa
        _naval = bool(_icg(args.group))
    except Exception:
        _naval = any(k in str(args.group).upper() for k in ("VF-", "VB-", "VS-", "VT-", "VCS-"))
    _key = "n" if _naval else "a"
    print(f"[witp-cmd] 设置 {args.group} 任务 = {args.mission}"
          f"（{'舰载 N' if _naval else '陆基 A'} 列表，箭头 x=653,y={y}）")
    vnc_click(300, 500, "click")
    time.sleep(0.5)
    vnc_key(_key)                     # 打开对应航空队列表
    time.sleep(3)

    # ★2026-10-01 修（换阵营暴露的「逐词精确比对」缺陷）★
    #   原实现把 TSV 每个**单词**与队名整串比对（且 x 过滤 150..260）。
    #   但 OCR 会把 `Genzan Ku K-1` 拆成 `Genzan`/`Ku`/`K-41` 三个词，
    #   任何一个都不等于整串 ⇒ 永远匹配不上（陆基中队因此全设不上任务）。
    #   改用已验证的 `_find_airgroup_row`：按 y 归并成行、整行归一后再匹配，
    #   并带字形混淆归一（V/Y、I/L、O/0、S/5、B/8）与唯一性要求。
    # ★2026-10-13 新增 --row★ 绕过 OCR 定位，直指列表行中心 y。
    #   动机：日军队名 OCR 极难辨认（`Genzan Ku K-2` → `genzankukk2g3m2nel`），
    #   当同一基地有两支同名中队时整行归一仍可能匹配失败 ⇒ 提供人工/脚本直指行号的后门。
    if getattr(args, "row", None):
        row_y = float(args.row)
        print(f"[witp-cmd] 使用 --row 指定行 y={row_y:.0f}（绕过 OCR 定位）")
    else:
        row_y = _find_airgroup_row(args.group, _key)
    if row_y is None:
        print(f"[witp-cmd] ✗ 在航空队列表里找不到「{args.group}」"
              f"（可加 --row <y> 直指行号）")
        return 1
    print(f"[witp-cmd] 找到 {args.group} 行 y≈{row_y:.0f}，点开详情屏")
    vnc_click(192, int(row_y), "click")
    time.sleep(3)

    vnc_click(653, y, "click")         # 点任务箭头
    time.sleep(2)

    if not args.no_verify:
        _shot_to("/tmp/_sm_after.png")
        try:
            import subprocess as _sp
            _sp.run("convert /tmp/_sm_after.png -resize 200% -colorspace Gray -normalize /tmp/_sm_g2.png",
                    shell=True, capture_output=True)
            tsv = _sp.run("tesseract /tmp/_sm_g2.png - --psm 11 tsv", shell=True,
                          capture_output=True, text=True).stdout
            hits = []
            for line in tsv.splitlines()[1:]:
                p = line.split("\t")
                if len(p) < 12:
                    continue
                t = p[11].strip()
                if len(t) >= 4 and any(w in t for w in ("Airfield", "Port", "Naval", "Ground",
                                                        "Recon", "ASW", "Supply", "City", "Training",
                                                        "Rest", "Stand")):
                    hits.append((t, int(p[6]) / 2.0, int(p[7]) / 2.0))
            # 详情屏右侧「Mission:」标签附近的当前任务文字
            cur = [h for h in hits if h[2] < 140 and h[1] > 600]
            print(f"[witp-cmd] 回读当前任务文字: {cur[:3] if cur else '（未识别到，请人工核对）'}")
        except Exception as e:
            print(f"[witp-cmd] 回读失败: {e}")
    print("[witp-cmd] ✓ 任务指令已下发（务必以详情屏/读层为准核对）")
    return 0


def main():
    parser = argparse.ArgumentParser(description="WitP 前线指挥官与操作手指令工具箱")
    sub = parser.add_subparsers(dest="action")

    p_staff = sub.add_parser("staff", help="指挥参谋部：出建议书 / --check 体检 / --fix 修复 / --resync 强制重读")
    p_staff.add_argument("--json", action="store_true")
    p_staff.add_argument("--scraper", action="store_true")
    p_staff.add_argument("--no-scraper", action="store_true", help="不强制重读存档（用已缓存 state/ JSON，调试用）")
    p_staff.add_argument("--saves", action="store_true", help="枚举可用存档（槽位/时间/日期）")
    p_staff.add_argument("--save", default=None,
                         help="指定参谋部解析的存档（槽位号 000/002/003、文件名或绝对路径）")
    p_staff.add_argument("--check", action="store_true", help="参谋部健康体检")
    p_staff.add_argument("--fix", action="store_true", help="修复参谋部（拉服务+重读存档+复验）")
    p_staff.add_argument("--resync", action="store_true", help="强制参谋部重读当前存档")
    p_staff.add_argument("--model", default=None, help="临时指定本回合使用的大模型名称 (如 gemini-3.7-flash-high, step-5-preview)")
    p_staff.add_argument("--fallbacks", default=None, help="临时指定备用模型链，逗号分隔 (如 claude-sonnet-4-6,step-5-preview)")

    p_model = sub.add_parser("model", help="模型管理：查看候选池 / 测试延迟 / 持久化指定主模型与备用链")
    p_m_sub = p_model.add_subparsers(dest="model_action")
    p_m_list = p_m_sub.add_parser("list", help="查看所有可用模型与当前主备配置")
    p_m_list.add_argument("--test", action="store_true", help="同时测试各模型的网络连通性与延迟")
    p_m_sub.add_parser("test", help="测试当前主模型与备用链的响应连通性与延迟")
    p_m_set = p_m_sub.add_parser("set", help="持久化指定主模型与备用链")
    p_m_set.add_argument("--primary", required=True, help="主模型名称 (如 gemini-3.7-flash-high, step-5-preview)")
    p_m_set.add_argument("--fallbacks", default=None, help="备用模型链，逗号分隔 (如 claude-sonnet-4-6,step-5-preview)")
    p_m_set.add_argument("--provider", default=None, help="指定主模型的 Provider 标识（可选）")

    p_launch = sub.add_parser("launch", help="自动重开/启动珊瑚海战役进入第1回合地图")

    p_dest = sub.add_parser("set-dest", help="设编队目标航向")
    p_dest.add_argument("tf_id", help="编队代号，如 TF14")
    p_dest.add_argument("hex_x", type=int, help="Hex X")
    p_dest.add_argument("hex_y", type=int, help="Hex Y")
    p_dest.add_argument("--probe", default=None, help="强制指定探针 Hex (如 101,155)，绕过 OCR 标定")
    p_dest.add_argument("--row", type=int, default=None, help="强制指定 T 列表行中心 y，绕过自动定位（TF3 等定位失败时用）")
    p_dest.add_argument("--deadline", type=float, default=140.0,
                        help="总时限秒（默认 140）。目标在小地图红框外时小地图跳转会被 clamp，"
                             "旧实现会无限重试导致挂死；超时限即返回并告警。")
    p_dest.add_argument("--no-jump", action="store_true",
                        help="跳过小地图跳转（调用方已自行摆好视野时用）")

    p_cap = sub.add_parser("set-cap", help="设航空队CAP比例")
    p_cap.add_argument("ag_id", help="航空队代号，如 VF-2")
    p_cap.add_argument("percent", type=int, choices=[0, 20, 40, 60, 80, 100], help="CAP百分比")
    p_cap.add_argument("--row", type=int, default=None, help="强制指定列表行中心 y，绕过自动定位")
    p_cap.add_argument("--cap-row", type=int, default=None,
                       help="强制指定详情屏 CAP 滑块行的 y（最可靠；"
                            "不指定时依次用 OCR 定位 → 列表行+42 → 303）")
    p_cap.add_argument("--list", default=None, choices=["n", "a"],
                       help="强制指定航空队列表：n=舰载 / a=陆基（读层判不准时用）")
    p_cap.add_argument("--alt", type=int, default=None, help="同时设定 CAP 高度（英尺），如 15000/6000 分层")

    # ★2026-09-29 新增：批量设 CAP（逐中队全部设定，防漏设）
    p_capa = sub.add_parser("set-cap-all",
                            help="批量设CAP：按前缀枚举所有同级中队（防漏设）")
    p_capa.add_argument("prefix", help="中队名前缀，逗号分隔，如 VF 或 VF,VCS")
    p_capa.add_argument("percent", type=int, choices=[0, 20, 40, 60, 80, 100],
                        help="CAP百分比")
    p_capa.add_argument("--alt", type=int, default=None, help="同时设定 CAP 高度")

    p_srch = sub.add_parser("set-search", help="设航空队对海搜索/反潜搜索比例（侦察纪律）")
    p_srch.add_argument("ag_id", help="航空队代号，如 VP-11 / No.11 Sqd RAAF / VS-2")
    p_srch.add_argument("percent", type=int, help="搜索百分比 0-100（按 10 为步进）")
    p_srch.add_argument("--asw", action="store_true", help="改设 ASW（反潜）比例而非 Search（对海）")
    p_srch.add_argument("--row", type=int, default=None, help="强制指定列表行中心 y，绕过自动定位")
    # ★2026-10-04 新增★ N 列表（舰载）OCR 认不出队名（实测整表几乎全乱码），
    #   `_find_airgroup_row` 因此必然失败 ⇒ 设了等于没设。
    #   纯像素行序通道：lib/rowfind.py 数文字密度行峰（实测 N 列表 12 行、行距精确 14px，
    #   起始 y=321），序号从 0 起，与队名 OCR 完全解耦。
    p_srch.add_argument("--row-index", type=int, default=None,
                        help="按像素行序定位（0 起）；N 列表 OCR 认不出队名时用")
    p_srch.add_argument("--row-index-base", type=int, default=None,
                        help="配合 --row-index：用于重新数行时的参考行数（仅打印对照）")

    p_svg = sub.add_parser("save-game", help="存档到指定槽位（F 键对话框；点【小箭头】而非文字）")
    p_svg.add_argument("--slot", type=int, default=3, help="槽位号（默认 003）")
    p_svg.add_argument("--allow-guess", action="store_true",
                       help="跳过「选中行槽位号回读核对」的守卫（危险：可能覆写其它槽位）")

    sub.add_parser("calibrate-map", help="实测地图几何（像素↔格），全剧本通用；修掉比例写死导致的偏 1 格")

    p_recov = sub.add_parser("recover", help="崩溃自愈：检测游戏进程/画面，必要时重启并载入最新 Autosave")
    p_recov.add_argument("--force", action="store_true", help="即使画面正常也强制走一遍恢复流程")
    p_recov.add_argument("--slot-row", type=int, default=212, help="存档列表 000 行的 y（默认 212）")

    # ★ 设置人类玩家阵营（GAMESTYLE 旋钮）★ 决定载入存档后人类执哪一方
    p_gs = sub.add_parser("set-gamestyle",
                          help="设主菜单 GAMESTYLE：japanese/allied（人机）/ pbem（邮件对战）/ both（AI对AI）/ h2h（热座）")
    p_gs.add_argument("side", choices=["japanese", "japan", "allied", "pbem", "both", "h2h"],
                      help="japanese=AI打日军(人类执盟军) / allied=AI打盟军(人类执日军) / "
                           "pbem=两人邮件对战 / both=电脑对电脑 / h2h=双人热座 / japan=japanese 的旧别名")
    p_gs.add_argument("--restart", action="store_true", help="不在主菜单时自动重启游戏服务")

    p_end = sub.add_parser("end-turn", help="过回合 (E + YES)")
    p_end.add_argument("--timeout", type=int, default=240, help="结算超时秒数")

    p_stat = sub.add_parser("status", help="查看屏幕画面与窗口状态")

    p_sa = sub.add_parser("strike-audit", help="审计航母舰载机的出击能力（任务/搜索占用/可用机/疑似阻断）")
    p_sa.add_argument("--state", default=None, help="读层 state 目录，默认标准位置")

    p_sm = sub.add_parser("set-mission", help="设置航空队任务（任务可自由指派，不跟中队名走）")
    p_sm.add_argument("--group", required=True, help="中队名，如 VB-2 / VS-5 / VT-2")
    p_sm.add_argument("--mission", required=True,
                      help="Naval Attack / Naval Search / ASW / Rest / Airfield Attack / Port Attack / "
                           "Ground Attack / Recon / Supply / City / Training / Stand Down")
    p_sm.add_argument("--no-verify", action="store_true", help="跳过回读核验")
    p_sm.add_argument("--row", type=int, default=None, help="强制指定列表行中心 y，绕过 OCR 定位")

    # ★ 改 TF 任务（补齐命令面核心缺口；游戏会把 BOMBARDMENT 自动改回 SURFACE）★
    p_tfm = sub.add_parser("set-tf-mission",
                           help="改任务编队任务：bombardment / surface / transport / cargo / amphibious / escort …")
    p_tfm.add_argument("--tf", required=True, help="编队代号，如 TF6")
    p_tfm.add_argument("--mission", required=True,
                       help="Bombardment / Surface Combat / Fast Transport / Transport / Cargo / "
                            "Air Transport / CV Escort / Amphibious / Tanker / Escort")
    p_tfm.add_argument("--row", type=int, default=None,
                       help="该 TF 在 T 列表中的行 y（默认按 TF6=317 推断，建议显式给出）")

    # ★ 航空队目标设定（对地/对机场轰炸的必要条件）★
    #   手册 7.2.1：Target 初值为 Commander's Discretion，必须显式设定，
    #   否则引擎自行决定（可能不起飞）。实测 game-051：任务=Ground Attack 但
    #   target=(None,None) ⇒ 对地轰炸从未起飞（战报零空袭记录）。
    p_tgt = sub.add_parser("set-target",
                           help="设航空队 Target hex（对地/对机场轰炸的必要条件；否则不会起飞）")
    p_tgt.add_argument("--group", required=True, help="中队名，如 'Genzan Ku K-1'")
    p_tgt.add_argument("--hex", required=True, help="目标格，格式 X,Y（如 98,130）")
    p_tgt.add_argument("--px", default=None,
                       help="目标在当前地图视口的像素 X,Y（可选；不给则点视口正中）")

    # ★ 地面部队战斗命令（补齐命令面最大缺口）★
    #   手册 8.2.1/8.4.3：地面部队上岸后**不会自动攻击**，必须由玩家下
    #   Deliberate/Shock Attack，否则基地归属永不改变。此前 22 局莫港攻不下即此因。
    p_rs = sub.add_parser("recon-status",
                          help="侦察态势检查：侦察机队的 search 分配缺口 + 可直接执行的修复命令")
    p_rs.add_argument("--json", action="store_true", help="以 JSON 输出")

    p_fs = sub.add_parser("fleet-status",
                          help="己方舰队状态：受损舰清单（航母优先）+ 已沉确认 + 高危告警")
    p_fs.add_argument("--json", action="store_true", help="以 JSON 输出（供脚本消费）")

    p_go = sub.add_parser("ground-order",
                          help="地面部队战斗命令（上岸后必须下令攻击，否则永远守在原地）")
    p_go.add_argument("place", help="地点/基地名，如 \"Port Moresby\"（按列表 Location 列筛选）")
    p_go.add_argument("order", help="defend / bombard / deliberate / shock")
    p_go.add_argument("--unit", default=None, help="只对名称含该串的单位下令（可选）")
    p_go.add_argument("--probe", action="store_true", help="只列出该地点的部队与当前 Combat 列，不下令")
    p_go.add_argument("--no-verify", action="store_true", help="跳过回读核验")

    p_sg = sub.add_parser("set-game", help="锁定「当前对局」编号（整局的因果记录/归档都以此为准）")
    p_sg.add_argument("game_id", help="对局目录名，如 game-050")
    p_ng = sub.add_parser("new-game", help="新建一局（编号=现有最大+1）并锁定为当前对局")

    p_rec = sub.add_parser("record-turn", help="回写本回合因果三元组 (S,D,R)")
    p_rec.add_argument("--decision", required=True, help="本回合决策与理由")
    p_rec.add_argument("--result", required=True, help="本回合实际战果")
    p_rec.add_argument("--orders", default="", help="执行的动作，分号分隔")
    p_rec.add_argument("--game", default=None, help="对局 ID，默认取最近")

    p_close = sub.add_parser("close-game", help="归档对局战果并追加台账")
    p_close.add_argument("--outcome", required=True, help="胜负判定，如 日军决定性胜利")
    p_close.add_argument("--enemy-score", type=int, default=None)
    p_close.add_argument("--own-score", type=int, default=None)
    p_close.add_argument("--notes", default="")
    p_close.add_argument("--game", default=None)

    p_skb = sub.add_parser("skb", help="战略知识库：看状态 / --add 追加**作战策略**教条并提交 Git")
    p_skb.add_argument("--add", default=None, help="要追加的教条正文（只收作战策略）")
    p_skb.add_argument("--confidence", type=float, default=None)
    p_skb.add_argument("--evidence", default=None)
    p_skb.add_argument("--scope", choices=["strategy", "ops"], default="strategy",
                       help="strategy=写 SKB（默认，供参谋部战略推理）；ops=写技能库操作笔记（不进参谋提示词）")

    args = parser.parse_args()
    if args.action == "staff":
        cmd_staff(args)
    elif args.action == "launch":
        cmd_launch(args)
    elif args.action == "set-dest":
        cmd_set_dest(args)
    elif args.action == "set-cap":
        cmd_set_cap(args)
    elif args.action == "set-cap-all":
        cmd_set_cap_all(args)
    elif args.action == "set-search":
        cmd_set_search(args)
    elif args.action == "save-game":
        cmd_save_game(args)
    elif args.action == "calibrate-map":
        cmd_calibrate_map(args)
    elif args.action == "recover":
        cmd_recover(args)
    elif args.action == "set-gamestyle":
        cmd_set_gamestyle(args)
    elif args.action == "end-turn":
        cmd_end_turn(args)
    elif args.action == "status":
        cmd_status(args)
    elif args.action == "strike-audit":
        cmd_strike_audit(args)
    elif args.action == "set-mission":
        cmd_set_mission(args)
    elif args.action == "set-tf-mission":
        cmd_set_tf_mission(args)
    elif args.action == "set-target":
        cmd_set_target(args)
    elif args.action == "recon-status":
        cmd_recon_status(args)
    elif args.action == "fleet-status":
        cmd_fleet_status(args)
    elif args.action == "ground-order":
        cmd_ground_order(args)
    elif args.action == "set-game":
        _set_current_game(args.game_id)
    elif args.action == "new-game":
        _new_game(args)
    elif args.action == "record-turn":
        cmd_record_turn(args)
    elif args.action == "close-game":
        cmd_close_game(args)
    elif args.action == "skb":
        cmd_skb(args)
    elif args.action == "model":
        cmd_model(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
