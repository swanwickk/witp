# 参谋管理 + 回写闭环
sys.path.insert(0, "/root/.hermes/profiles/witp/witp-agent")
try:
    from witp_cmd_staffops import (
        staff_check, staff_fix, staff_resync,
        record_turn, close_game, skb_add_doctrine, skb_status,
        set_current_game, new_game,
    )
    _STAFFOPS = True
except Exception as _e:
    _STAFFOPS = False
    _STAFFOPS_ERR = str(_e)

def cmd_staff(args):
    """指挥参谋部：默认出建议书；--saves 枚举存档；--save 指定存档；--check 体检；--fix 修复；--resync 强制重读"""
    staff_script = os.path.join(AGENT_DIR, "witp_staff.py")

    # ── 枚举可用存档（让指挥官知道能指定哪些） ──
    if getattr(args, "saves", False):
        subprocess.run([_VENV_PY, staff_script, "brief", "--saves"])
        return

    # ── 指定存档：主动指挥参谋部去解析这一份 ──
    if getattr(args, "save", None):
        cmd = [_VENV_PY, staff_script, "brief", "--save", str(args.save)]
        if getattr(args, "json", False):
            cmd.append("--json")
        print(f"[witp-cmd] 指挥参谋部解析指定存档：{args.save}")
        rc = subprocess.run(cmd).returncode
        sys.exit(rc)

    if not _STAFFOPS:
        print(f"[witp-cmd] 参谋管理模块加载失败: {_STAFFOPS_ERR}")
        return
    if getattr(args, "check", False):
        healthy, _ = staff_check(verbose=True)
        sys.exit(0 if healthy else 1)
    if getattr(args, "fix", False):
        ok, _ = staff_fix(verbose=True)
        sys.exit(0 if ok else 1)
    if getattr(args, "resync", False):
        d = staff_resync(verbose=True)
        sys.exit(0 if (d and d.get("ok")) else 1)

    # 出建议书前先体检，不健康则明确告警（但不阻断，交由指挥官处置）
    healthy, rep = staff_check(verbose=False)
    if not healthy:
        print("[witp-cmd] ⚠️ 参谋部体检未通过，建议书可能基于过期数据：")
        for i in rep.get("issues", []):
            print(f"         - {i}")
        print("         → 修复命令： witp-cmd staff fix")
        print()

    # 默认强制读最新存档（第六局修复：不再让参谋读陈旧 state/ JSON）
    # - 优先用 SAVE 目录最新 .pws；--no-scraper 可显式关闭
    staff_script = os.path.join(AGENT_DIR, "witp_staff.py")
    cmd = [_VENV_PY, staff_script, "brief"]
    if args.json:
        cmd.append("--json")
    if getattr(args, "scraper", False) or not getattr(args, "no_scraper", False):
        cmd.append("--scraper")
    if getattr(args, "save", None):
        cmd += ["--save", str(args.save)]
    else:
        # 自动指定最新存档（槽位 000 = Autosave 通常是结算后新状态）
        newest = _newest_save_path()
        if newest:
            slot = os.path.basename(newest).replace("wpae", "").replace(".pws", "")
            cmd += ["--save", slot]

    if getattr(args, "model", None):
        cmd += ["--model", str(args.model)]
    if getattr(args, "fallbacks", None):
        cmd += ["--fallbacks", str(args.fallbacks)]

    subprocess.run(cmd)

def cmd_model(args):
    """参谋大模型管理：查看候选池 / 测试响应连通性 / 指定主模型与备用链"""
    from witp_models import list_models_status, set_models
    action = getattr(args, "model_action", "list") or "list"
    if action == "list":
        list_models_status(test=getattr(args, "test", False))
    elif action == "test":
        list_models_status(test=True)
    elif action == "set":
        primary = args.primary
        fallbacks = [f.strip() for f in args.fallbacks.split(",") if f.strip()] if getattr(args, "fallbacks", None) else None
        res = set_models(primary, fallbacks=fallbacks, primary_provider=getattr(args, "provider", None))
        if res.get("ok"):
            print(f"[witp-cmd] ✓ 参谋模型配置已持久化更新！")
            print(f"  主模型: {res['primary']['model']} (Provider: {res['primary']['provider_id']})")
            if res.get("fallbacks"):
                print("  备用链 (顺序回退):")
                for idx, fb in enumerate(res["fallbacks"], 1):
                    print(f"    {idx}. {fb['model']} (Provider: {fb['provider_id']})")
        else:
            print(f"[witp-cmd] ❌ 设置失败: {res.get('error')}")

def _newest_save_path():
    """返回当前正在玩的活跃存档路径（优先 wpae000.pws Autosave，无则最新 .pws）。"""
    import glob as _glob
    auto_pws = "/root/.wine-witp/drive_c/1108r9/War in the Pacific Admiral's Edition/SAVE/wpae000.pws"
    if os.path.exists(auto_pws):
        return auto_pws
    saves = _glob.glob("/root/.wine-witp/drive_c/1108r9/War in the Pacific Admiral's Edition/SAVE/*.pws")
    if not saves:
        return None
    return max(saves, key=os.path.getmtime)

