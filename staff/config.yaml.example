# WitP-AE 作战参谋大模型与推演服务配置示例 (config.yaml.example)
# 使用前请复制为 config.yaml 并填入实际的大模型 API Key 与路径。

strategy_model:
  base_url: https://api.openai.com/v1
  model: gpt-4o
  api_key: "<YOUR_API_KEY>"
  max_tokens: 4096
  temperature: 0.3
  provider_id: openai
  provider_name: OpenAI
  fallbacks:
  - base_url: https://api.anthropic.com/v1
    model: claude-3-5-sonnet-20241022
    api_key: "<YOUR_ANTHROPIC_KEY>"
    provider_id: anthropic
    provider_name: Anthropic

kev_server:
  host: 127.0.0.1
  port: 18090
  model: kev-0.8b

game:
  # 游戏 SAVE 目录与主程序目录（根据实际 Wine 或 Windows 路径配置）
  save_dir: "/path/to/War in the Pacific Admiral's Edition/SAVE"
  exe_dir: "/path/to/War in the Pacific Admiral's Edition"
  vnc_display: ":98"
  vnc_port: 5902

providers_pool:
- id: openai
  name: OpenAI
  base_url: https://api.openai.com/v1
  api_key: "<YOUR_OPENAI_KEY>"
  models:
  - gpt-4o
  - gpt-4o-mini
  - gpt-4-turbo
  - o1
  - o3-mini

- id: anthropic
  name: Anthropic
  base_url: https://api.anthropic.com/v1
  api_key: "<YOUR_ANTHROPIC_KEY>"
  models:
  - claude-3-5-sonnet-20241022
  - claude-3-5-haiku-20241022
  - claude-3-opus-20240229

- id: opencode
  name: opencode
  base_url: https://opencode.ai/zen/go/v1
  api_key: "<YOUR_OPENCODE_KEY>"
  models:
  - deepseek-v4-pro
  - deepseek-v4.1-flash
  - glm-5.3
  - glm-5.3-flash
  - qwen3.8-max
  - kimi-k3
  - minimax-m3

- id: stepfun
  name: stepfun
  base_url: https://api.stepfun.com/step_plan/v1
  api_key: "<YOUR_STEPFUN_KEY>"
  models:
  - step-3.5-flash
  - step-3.7-flash
  - step-5-preview

- id: local-gateway
  name: local-gateway
  base_url: http://127.0.0.1:8000/v1
  api_key: "<YOUR_LOCAL_TOKEN>"
  models:
  - local-model
